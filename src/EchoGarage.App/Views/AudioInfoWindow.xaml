<views:ThemedWindow x:Class="EchoGarage.App.Views.AudioInfoWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EchoGarage.App.Views"
                    Title="音频信息"
                    Width="560" Height="780"
                    MinWidth="440" MinHeight="520"
                    WindowStartupLocation="CenterOwner"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12"
                    ResizeMode="CanResize"
                    ShowInTaskbar="False"
                    UseLayoutRounding="True"
                    SnapsToDevicePixels="True"
                    PreviewKeyDown="OnWindowPreviewKeyDown"
                    AutomationProperties.AutomationId="AudioInfoWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：标题 + 当前歌曲 + 一句话摘要（源格式 → 输出格式）。 -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="音频信息" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding TrackTitle}" FontSize="13" FontWeight="SemiBold" Margin="0,7,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding TrackSubtitle}" FontSize="11.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Summary}" FontSize="11.5" Margin="0,6,0,0"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Summary}" />
                </StackPanel>
                <Button Grid.Column="1" Content="关闭" Style="{StaticResource FlatButton}"
                        VerticalAlignment="Top" Click="OnCloseClick"
                        AutomationProperties.AutomationId="AudioInfoClose" />
            </Grid>
        </Border>

        <!-- 管线：按数据流方向从音轨 → 解码 → 转换 → 处理 → 缓冲区 → 输出 → 引擎/端点逐段展示。 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,14,16,14"
                      AutomationProperties.AutomationId="AudioInfoScroll">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Stages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- 段与段之间的“数据流”连接符。 -->
                                <TextBlock Text="↓" FontSize="13" HorizontalAlignment="Left" Margin="14,3,0,5"
                                           Foreground="{DynamicResource TextMutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasConnectorAbove}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="14,11">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding Headline}" FontSize="13.5" FontWeight="SemiBold"
                                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <ItemsControl ItemsSource="{Binding Details}" Margin="0,7,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                                   Width="78" FontSize="11"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   VerticalAlignment="Top" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                                   FontSize="11.5" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 弱化提示：例如独占模式下被忽略的 Windows 默认设备格式（暗色小字，不占管线段落）。 -->
                <TextBlock x:Name="HintText" Margin="14,12,14,2" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <TextBlock Text="数据按从上到下的顺序流经整条音频管线 · Esc 关闭"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
        </Border>
    </Grid>
</views:ThemedWindow>
