<views:ThemedWindow x:Class="EchoGarage.App.Views.CoverRecompressWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EchoGarage.App.Views"
                    Title="封面压缩"
                    Width="520"
                    SizeToContent="Height"
                    ResizeMode="NoResize"
                    WindowStartupLocation="CenterOwner"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12"
                    ShowInTaskbar="False"
                    KeyDown="OnWindowKeyDown">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <Border Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,10,0,0">
            <StackPanel>
                <TextBlock x:Name="CoverInfoText" TextWrapping="Wrap" />
                <TextBlock x:Name="SettingInfoText"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="ScopeText"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="Collapsed" />
        <TextBlock x:Name="HintText"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="取消"
                    Style="{StaticResource FlatButton}"
                    IsCancel="True"
                    Click="OnCancelClick"
                    Margin="0,0,8,0" />
            <Button Content="仍然压缩"
                    Style="{StaticResource FlatButton}"
                    Click="OnCompressClick"
                    Margin="0,0,8,0"
                    ToolTip="按上面的质量与最大边长重新做一次有损编码，只有体积更小时才替换原封面。" />
            <Button Content="保持原样"
                    Style="{StaticResource AccentButton}"
                    IsDefault="True"
                    Click="OnKeepClick"
                    ToolTip="照常保存其它标签，封面字节保持不变。" />
        </StackPanel>
    </StackPanel>
</views:ThemedWindow>
