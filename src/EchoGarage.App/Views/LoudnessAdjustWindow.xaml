<views:ThemedWindow x:Class="EchoGarage.App.Views.LoudnessAdjustWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EchoGarage.App.Views"
                    Title="响度调整"
                    Width="640" MinWidth="600" MinHeight="480"
                    SizeToContent="Height"
                    ResizeMode="CanResize"
                    WindowStartupLocation="CenterOwner"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12"
                    ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="20,16,20,16">
            <TextBlock Text="源文件" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
            <TextBlock x:Name="SourceNameText"
                       FontSize="14" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SourcePathText"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0" />
            <TextBlock x:Name="SourceInfoText"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />

            <Border x:Name="ProgressPanel"
                    Visibility="Collapsed"
                    Background="{DynamicResource PanelAltBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProgressLabelText"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ProgressPercentText"
                                   Grid.Column="1"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="12,0,0,0" />
                    </Grid>
                    <ProgressBar x:Name="AdjustProgress"
                                 Height="6"
                                 Minimum="0" Maximum="100"
                                 Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="CancelOperationButton"
                                Content="取消分析"
                                Style="{StaticResource FlatButton}"
                                MinWidth="88"
                                Click="OnCancelOperationClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel x:Name="RetryPanel"
                        Visibility="Collapsed"
                        Orientation="Horizontal"
                        Margin="0,10,0,0">
                <TextBlock x:Name="AnalysisErrorText"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           MaxWidth="420"
                           Margin="0,0,12,0" />
                <Button Content="重新分析"
                        Style="{StaticResource FlatButton}"
                        Click="OnRetryAnalyzeClick" />
            </StackPanel>

            <TextBlock Text="测量结果" Style="{StaticResource SectionLabel}" Margin="0,16,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="积分响度（I）"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,12,4" />
                <TextBlock x:Name="IntegratedValueText"
                           Grid.Column="1"
                           Text="—"
                           FontWeight="SemiBold"
                           Margin="0,0,24,4" />

                <TextBlock Text="响度范围（LRA）"
                           Grid.Column="2"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,12,4" />
                <TextBlock x:Name="LoudnessRangeValueText"
                           Grid.Column="3"
                           Text="—"
                           Margin="0,0,0,4" />

                <TextBlock Text="真峰值（TP）"
                           Grid.Row="1"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,12,0" />
                <TextBlock x:Name="TruePeakValueText"
                           Grid.Row="1" Grid.Column="1"
                           Text="—"
                           Margin="0,0,24,0" />

                <TextBlock Text="采样峰值"
                           Grid.Row="1" Grid.Column="2"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,12,0" />
                <TextBlock x:Name="SamplePeakValueText"
                           Grid.Row="1" Grid.Column="3"
                           Text="—" />
            </Grid>

            <TextBlock Text="目标" Style="{StaticResource SectionLabel}" Margin="0,16,0,4" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="LowerRadio"
                             Content="降低"
                             GroupName="AdjustMode"
                             IsChecked="True"
                             Checked="OnModeChanged"
                             VerticalAlignment="Center" />
                <RadioButton x:Name="RaiseRadio"
                             Content="提升"
                             GroupName="AdjustMode"
                             Margin="18,0,0,0"
                             Checked="OnModeChanged"
                             VerticalAlignment="Center" />
                <TextBox x:Name="TargetBox"
                         Width="88"
                         Margin="24,0,0,0"
                         TextAlignment="Right"
                         VerticalContentAlignment="Center"
                         TextChanged="OnTargetChanged"
                         LostFocus="OnTargetLostFocus" />
                <TextBlock Text="LUFS"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="HintText"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />

            <TextBlock Text="无失真上限" Style="{StaticResource SectionLabel}" Margin="0,16,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="当前真峰值"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,12,4" />
                <TextBlock x:Name="CurrentPeakText"
                           Grid.Column="1"
                           Text="—"
                           Margin="0,0,0,4" />

                <TextBlock Text="输出格式天花板"
                           Grid.Row="1"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,12,4" />
                <TextBlock x:Name="CeilingText"
                           Grid.Row="1" Grid.Column="1"
                           Text="—"
                           Margin="0,0,0,4" />

                <TextBlock Text="最多可提升"
                           Grid.Row="2"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,12,4" />
                <TextBlock x:Name="MaxBoostText"
                           Grid.Row="2" Grid.Column="1"
                           Text="—"
                           Margin="0,0,0,4" />

                <TextBlock Text="可达到响度"
                           Grid.Row="3"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,12,0" />
                <TextBlock x:Name="ReachableLufsText"
                           Grid.Row="3" Grid.Column="1"
                           Text="—" />
            </Grid>

            <TextBlock Text="实际增益与预计输出" Style="{StaticResource SectionLabel}" Margin="0,16,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="实际增益"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,12,4" />
                <TextBlock x:Name="AppliedGainText"
                           Grid.Column="1"
                           Text="—"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="0,0,0,4" />
                <TextBlock Text="预计输出"
                           Grid.Row="1"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,12,0" />
                <TextBlock x:Name="ExpectedOutputText"
                           Grid.Row="1" Grid.Column="1"
                           Text="—" />
            </Grid>

            <TextBlock Text="输出" Style="{StaticResource SectionLabel}" Margin="0,16,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="输出格式"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <ComboBox x:Name="FormatCombo"
                          Grid.Column="1"
                          Width="190"
                          HorizontalAlignment="Left"
                          SelectedIndex="0"
                          SelectionChanged="OnFormatChanged">
                    <ComboBoxItem Content="FLAC（无损）" Tag="Flac" />
                    <ComboBoxItem Content="WAV（无损）" Tag="Wav" />
                    <ComboBoxItem Content="MP3（有损）" Tag="Mp3" />
                    <ComboBoxItem Content="AAC（有损）" Tag="Aac" />
                </ComboBox>

                <TextBlock Text="输出路径"
                           Grid.Row="1"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,8,12,0" />
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputPathBox"
                             VerticalContentAlignment="Center"
                             TextChanged="OnOutputPathChanged" />
                    <Button x:Name="BrowseButton"
                            Grid.Column="1"
                            Content="浏览…"
                            Style="{StaticResource FlatButton}"
                            Margin="8,0,0,0"
                            Click="OnBrowseClick" />
                </Grid>
            </Grid>
            <TextBlock x:Name="ResampleHintText"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Visibility="Collapsed" />

            <Border x:Name="SuccessPanel"
                    Visibility="Collapsed"
                    Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="调整完成" FontWeight="SemiBold" />
                    <TextBlock x:Name="OutputPathText"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="OutputMeasuredText"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="OvershootText"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Visibility="Collapsed" />
                    <Button x:Name="RevealOutputButton"
                            Content="在资源管理器中显示"
                            Style="{StaticResource FlatButton}"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Click="OnRevealOutputClick" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="StartButton"
                        Content="开始调整"
                        Style="{StaticResource AccentButton}"
                        MinWidth="104"
                        Click="OnStartClick" />
                <Button x:Name="CloseButton"
                        Content="关闭"
                        Style="{StaticResource FlatButton}"
                        MinWidth="80"
                        Margin="8,0,0,0"
                        Click="OnCloseClick" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</views:ThemedWindow>
