<views:ThemedWindow x:Class="EchoGarage.App.Views.SearchWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EchoGarage.App.Views"
                    Title="高级搜索"
                    Width="600" Height="580"
                    MinWidth="520" MinHeight="500"
                    WindowStartupLocation="CenterOwner"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12"
                    ShowInTaskbar="False"
                    KeyDown="OnWindowKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="关键词" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
            <TextBox x:Name="KeywordBox"
                     Height="30"
                     VerticalContentAlignment="Center"
                     ToolTip="空格分隔多个关键词；英文双引号可保留短语中的空格，例如 &quot;kizuna ai&quot;。" />
            <TextBlock Text="搜索范围：当前播放列表"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11"
                       Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="匹配字段" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8">
                <ItemsControl x:Name="FieldItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Label}"
                                      IsChecked="{Binding IsSelected}"
                                      MinWidth="92"
                                      Margin="0,3,12,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="匹配方式" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AnyModeRadio"
                             Content="任一字段匹配"
                             GroupName="FieldMode"
                             IsChecked="True" />
                <RadioButton x:Name="AllModeRadio"
                             Content="全部字段匹配"
                             GroupName="FieldMode"
                             Margin="18,0,0,0" />
            </StackPanel>
            <TextBlock Text="任一字段：关键词出现在所选字段的任意一个即可，例如同时在“作曲家”和“艺术家”里查找。全部字段：关键词必须同时出现在所有所选字段里。"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Foreground="{DynamicResource DangerBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   VerticalAlignment="Bottom"
                   Margin="0,8,0,0" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="清除搜索"
                    Style="{StaticResource FlatButton}"
                    Click="OnClearClick"
                    Margin="0,0,8,0" />
            <Button Content="取消"
                    Style="{StaticResource FlatButton}"
                    IsCancel="True"
                    Margin="0,0,8,0" />
            <Button Content="搜索"
                    Style="{StaticResource AccentButton}"
                    IsDefault="True"
                    Click="OnSearchClick"
                    MinWidth="88" />
        </StackPanel>
    </Grid>
</views:ThemedWindow>
