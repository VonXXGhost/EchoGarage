<views:ThemedWindow x:Class="EchoGarage.App.Views.ConversionResampleWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EchoGarage.App.Views"
                    Title="转换器"
                    Width="500"
                    SizeToContent="Height"
                    ResizeMode="NoResize"
                    WindowStartupLocation="CenterOwner"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12"
                    ShowInTaskbar="False"
                    KeyDown="OnWindowKeyDown">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <TextBlock x:Name="RateText"
                   TextWrapping="Wrap"
                   FontWeight="SemiBold"
                   Margin="0,10,0,0" />
        <TextBlock x:Name="HintText"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />
        <TextBlock x:Name="NoteText"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="取消转换"
                    Style="{StaticResource FlatButton}"
                    IsCancel="True"
                    Click="OnCancelClick"
                    Margin="0,0,8,0" />
            <Button Content="保持源采样率"
                    Style="{StaticResource FlatButton}"
                    Click="OnKeepClick"
                    Margin="0,0,8,0" />
            <Button x:Name="DownsampleButton"
                    Content="降采样"
                    Style="{StaticResource AccentButton}"
                    IsDefault="True"
                    Click="OnDownsampleClick" />
        </StackPanel>
    </StackPanel>
</views:ThemedWindow>
