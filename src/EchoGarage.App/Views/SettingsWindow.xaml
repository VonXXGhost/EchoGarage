<views:ThemedWindow x:Class="EchoGarage.App.Views.SettingsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EchoGarage.App.Views"
                    xmlns:hotkeys="clr-namespace:EchoGarage.App.Controls"
                    Title="设置"
                    Width="880" Height="760"
                    MinWidth="760" MinHeight="560"
                    WindowStartupLocation="CenterOwner"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12"
                    ShowInTaskbar="False"
                    KeyDown="OnWindowKeyDown">
    <views:ThemedWindow.Resources>
        <Style x:Key="DestinationListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsNavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </views:ThemedWindow.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="6">
            <ListBox x:Name="SettingsNav" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnSettingsNavChanged"
                     ItemContainerStyle="{StaticResource SettingsNavItem}">
                <ListBoxItem Content="外观" Tag="Appearance" />
                <ListBoxItem Content="播放与音频" Tag="Playback" />
                <ListBoxItem Content="快捷键" Tag="Hotkeys" />
                <ListBoxItem Content="媒体库与缓存" Tag="Library" />
                <ListBoxItem Content="文件与转换" Tag="Files" />
                <ListBoxItem Content="网络与标签" Tag="Network" />
                <ListBoxItem Content="关于" Tag="About" />
            </ListBox>
        </Border>

        <ScrollViewer Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto">
            <Grid>

                <StackPanel x:Name="PageAppearance" Visibility="Visible">
                    <!-- Appearance -->
                    <TextBlock Text="界面" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="主题" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox Grid.Column="1" Width="160" HorizontalAlignment="Left"
                                          ItemsSource="{Binding ThemeOptions}" SelectedIndex="{Binding ThemeIndex}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PagePlayback" Visibility="Collapsed">
                    <!-- Audio output -->
                    <TextBlock Text="音频输出" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="输出设备" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Devices}" DisplayMemberPath="FriendlyName"
                                          SelectedItem="{Binding SelectedDevice}" Height="28" Margin="0,0,10,0" />
                                <Button Grid.Column="2" Content="刷新" Style="{StaticResource FlatButton}"
                                        Click="OnRefreshDevices" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="输出模式" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox Grid.Column="1" Width="160" HorizontalAlignment="Left"
                                          ItemsSource="{Binding OutputModeOptions}" SelectedIndex="{Binding OutputModeIndex}" />
                            </Grid>
                            <TextBlock Text="音量上限（按模式）" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="90,14,0,0" />
                            <Grid Margin="90,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="共享模式" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                <Slider Grid.Row="0" Grid.Column="1" Minimum="5" Maximum="100"
                                        AutomationProperties.AutomationId="SharedVolumeCeilingSlider"
                                        Value="{Binding SharedVolumeCeiling, Mode=TwoWay}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           Text="{Binding SharedVolumeCeiling, StringFormat={}{0:0}%}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="独占模式" VerticalAlignment="Center"
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="5" Maximum="100" Margin="0,6,0,0"
                                        AutomationProperties.AutomationId="ExclusiveVolumeCeilingSlider"
                                        Value="{Binding ExclusiveVolumeCeiling, Mode=TwoWay}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,6,0,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           Text="{Binding ExclusiveVolumeCeiling, StringFormat={}{0:0}%}" />
                            </Grid>
                            <TextBlock Text="音量滑块的 100% 对应这里设置的上限：实际输出 = 滑块百分比 × 上限。"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                                       Margin="90,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Playback visualizer (ADR-023) -->
                    <TextBlock Text="播放可视化" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="分段数越大低频分得越细；FFT 越大频率分辨率越高、柱体反应越迟钝。"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="可视化方式" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox x:Name="VisualizerKindBox" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                          SelectionChanged="OnVisualizerComboChanged">
                                    <ComboBoxItem Content="关闭" Tag="None" />
                                    <ComboBoxItem Content="分段频谱图" Tag="Spectrum" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="帧率上限" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox x:Name="VisualizerFrameRateBox" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                          SelectionChanged="OnVisualizerComboChanged">
                                    <ComboBoxItem Content="不限制（默认）" Tag="Unlimited" />
                                    <ComboBoxItem Content="30 FPS" Tag="Fps30" />
                                    <ComboBoxItem Content="60 FPS" Tag="Fps60" />
                                    <ComboBoxItem Content="120 FPS" Tag="Fps120" />
                                    <ComboBoxItem Content="144 FPS" Tag="Fps144" />
                                    <ComboBoxItem Content="180 FPS" Tag="Fps180" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="分段数" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox x:Name="SpectrumBandBox" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                          SelectionChanged="OnVisualizerComboChanged">
                                    <ComboBoxItem Content="16 段" Tag="16" />
                                    <ComboBoxItem Content="24 段" Tag="24" />
                                    <ComboBoxItem Content="32 段（默认）" Tag="32" />
                                    <ComboBoxItem Content="40 段" Tag="40" />
                                    <ComboBoxItem Content="48 段" Tag="48" />
                                    <ComboBoxItem Content="64 段" Tag="64" />
                                    <ComboBoxItem Content="96 段" Tag="96" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="FFT 大小" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox x:Name="SpectrumFftBox" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                          SelectionChanged="OnVisualizerComboChanged">
                                    <ComboBoxItem Content="1024（最灵敏）" Tag="1024" />
                                    <ComboBoxItem Content="2048" Tag="2048" />
                                    <ComboBoxItem Content="4096（默认）" Tag="4096" />
                                    <ComboBoxItem Content="8192（低频最准）" Tag="8192" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="频率范围" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox x:Name="SpectrumMinFreqBox" Width="110"
                                              SelectionChanged="OnVisualizerComboChanged">
                                        <ComboBoxItem Content="20 Hz" Tag="20" />
                                        <ComboBoxItem Content="30 Hz" Tag="30" />
                                        <ComboBoxItem Content="40 Hz（默认）" Tag="40" />
                                        <ComboBoxItem Content="50 Hz" Tag="50" />
                                        <ComboBoxItem Content="80 Hz" Tag="80" />
                                    </ComboBox>
                                    <TextBlock Text="—" Margin="8,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <ComboBox x:Name="SpectrumMaxFreqBox" Width="130"
                                              SelectionChanged="OnVisualizerComboChanged">
                                        <ComboBoxItem Content="12 kHz" Tag="12000" />
                                        <ComboBoxItem Content="14 kHz" Tag="14000" />
                                        <ComboBoxItem Content="16 kHz" Tag="16000" />
                                        <ComboBoxItem Content="18 kHz（默认）" Tag="18000" />
                                        <ComboBoxItem Content="20 kHz" Tag="20000" />
                                        <ComboBoxItem Content="22 kHz" Tag="22000" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="频段聚合" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox x:Name="SpectrumSummationBox" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                          SelectionChanged="OnVisualizerComboChanged">
                                    <ComboBoxItem Content="平均功率（RMS，默认）" Tag="Rms" />
                                    <ComboBoxItem Content="峰值（Peak）" Tag="Peak" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="显示下限" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox x:Name="SpectrumFloorBox" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                          SelectionChanged="OnVisualizerComboChanged">
                                    <ComboBoxItem Content="−90 dB" Tag="-90" />
                                    <ComboBoxItem Content="−80 dB" Tag="-80" />
                                    <ComboBoxItem Content="−70 dB" Tag="-70" />
                                    <ComboBoxItem Content="−60 dB" Tag="-60" />
                                    <ComboBoxItem Content="−50 dB（默认）" Tag="-50" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="频谱斜率" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox x:Name="SpectrumSlopeBox" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                          SelectionChanged="OnVisualizerComboChanged">
                                    <ComboBoxItem Content="0 dB/oct（平坦）" Tag="0" />
                                    <ComboBoxItem Content="1.5 dB/oct" Tag="1.5" />
                                    <ComboBoxItem Content="3 dB/oct（默认）" Tag="3" />
                                    <ComboBoxItem Content="4.5 dB/oct" Tag="4.5" />
                                    <ComboBoxItem Content="6 dB/oct" Tag="6" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="释放速度" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox x:Name="SpectrumReleaseBox" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                          SelectionChanged="OnVisualizerComboChanged">
                                    <ComboBoxItem Content="10 dB/s（缓慢）" Tag="10" />
                                    <ComboBoxItem Content="20 dB/s" Tag="20" />
                                    <ComboBoxItem Content="30 dB/s" Tag="30" />
                                    <ComboBoxItem Content="45 dB/s（默认）" Tag="45" />
                                    <ComboBoxItem Content="60 dB/s（迅速回落）" Tag="60" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="峰值保持" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <CheckBox x:Name="SpectrumPeakShowCheck" Content="显示峰值线" VerticalAlignment="Center"
                                              Checked="OnVisualizerToggleChanged" Unchecked="OnVisualizerToggleChanged" />
                                    <ComboBox x:Name="SpectrumPeakHoldBox" Width="140" Margin="12,0,0,0"
                                              SelectionChanged="OnVisualizerComboChanged">
                                        <ComboBoxItem Content="不保持" Tag="0" />
                                        <ComboBoxItem Content="400 ms" Tag="400" />
                                        <ComboBoxItem Content="800 ms（默认）" Tag="800" />
                                        <ComboBoxItem Content="1200 ms" Tag="1200" />
                                        <ComboBoxItem Content="2000 ms" Tag="2000" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="刻度" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <CheckBox x:Name="SpectrumGraticuleCheck" Content="dB 刻度线" VerticalAlignment="Center"
                                              Checked="OnVisualizerToggleChanged" Unchecked="OnVisualizerToggleChanged" />
                                    <CheckBox x:Name="SpectrumFrequencyLabelsCheck" Content="频率标签" Margin="16,0,0,0"
                                              VerticalAlignment="Center"
                                              Checked="OnVisualizerToggleChanged" Unchecked="OnVisualizerToggleChanged" />
                                </StackPanel>
                            </Grid>

                            <Button Content="恢复默认参数" Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                                    Margin="0,8,0,0" Click="OnResetVisualizerSettings" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageHotkeys" Visibility="Collapsed">
                    <TextBlock Text="快捷键" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                    <TextBlock Text="Esc 取消并恢复原值，Backspace 或 Delete 清除。"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="播放、音量与搜索" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                            <ItemsControl x:Name="HotkeyList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ActionLabel}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <hotkeys:HotkeyCaptureButton Grid.Column="1" Height="26" Margin="0,0,10,0"
                                                                         Style="{StaticResource HotkeyCaptureButton}"
                                                                         Gesture="{Binding Gesture, Mode=OneWay}"
                                                                         GestureCommitted="OnHotkeyGestureCommitted" />
                                            <CheckBox Grid.Column="2" Content="全局" IsChecked="{Binding Global}"
                                                      Click="OnHotkeyGlobalChanged" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="HotkeyStatusText" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                       Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="转换预设快捷键" Style="{StaticResource SectionLabel}" Margin="0,14,0,8" />
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <ItemsControl x:Name="PresetHotkeyList" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <hotkeys:HotkeyCaptureButton Grid.Column="1" Height="26" Margin="0,0,10,0"
                                                                         Style="{StaticResource HotkeyCaptureButton}"
                                                                         Gesture="{Binding Hotkey, Mode=OneWay}"
                                                                         GestureCommitted="OnPresetHotkeyGestureCommitted" />
                                            <CheckBox Grid.Column="2" Content="全局" IsChecked="{Binding Global, Mode=OneWay}"
                                                      Click="OnPresetHotkeyGlobalChanged" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="PresetHotkeyStatusText" Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="内置快捷键（只读）" Style="{StaticResource SectionLabel}" Margin="0,14,0,8" />
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="以下为程序内置的默认按键，不能修改；对应的可自定义动作留空/未设置时生效。"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                            <ItemsControl x:Name="BuiltInHotkeyList" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Gesture}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageLibrary" Visibility="Collapsed">
                    <!-- Library -->
                    <TextBlock Text="媒体库" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <CheckBox x:Name="AutoScanCheck" Content="启动时自动扫描媒体库（仅处理变化的文件）"
                                      Click="OnToggleAutoScan" />
                            <CheckBox x:Name="RestoreLastCheck" Content="启动时恢复上次打开的播放列表与曲目"
                                      Margin="0,10,0,0" Click="OnToggleRestoreLast" />
                            <TextBlock x:Name="LibrarySummaryText" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,10,0,0" />
                            <ListBox x:Name="FolderList" Margin="0,10,0,0" MaxHeight="150" Background="Transparent"
                                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Folder.Path}" ToolTip="{Binding Folder.Path}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Button Grid.Column="1" Content="移除" Style="{StaticResource FlatButton}"
                                                    Foreground="{DynamicResource DangerBrush}" Click="OnRemoveFolder" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="扫描媒体库" Style="{StaticResource FlatButton}" Click="OnRescan" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Cache -->
                    <TextBlock Text="缓存与数据" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="封面缓存目录" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CacheDirBox" Grid.Column="0" Height="28" />
                                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource FlatButton}"
                                        Margin="8,0,0,0" Click="OnBrowseCache" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="应用目录" Style="{StaticResource FlatButton}" Click="OnApplyCache" />
                                <Button Content="打开目录" Style="{StaticResource FlatButton}" Click="OnOpenCache" />
                                <Button x:Name="ClearCacheButton" Content="清空缓存 ▾" Style="{StaticResource FlatButton}"
                                        Click="OnClearCacheMenuClick">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="ClearCacheMenu" Opened="OnClearCacheMenuOpened">
                                            <MenuItem x:Name="ClearCoverCacheItem" Header="清空封面缓存" Click="OnClearCoverCache" />
                                            <MenuItem x:Name="ClearWaveformCacheItem" Header="清空波形缓存" Click="OnClearWaveformCache" />
                                            <MenuItem x:Name="ClearBpmCacheItem" Header="清空 BPM 测量缓存" Click="OnClearBpmCache" />
                                            <Separator />
                                            <MenuItem x:Name="ClearAllCachesItem" Header="清空全部缓存" Click="OnClearAllCaches" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="CacheStatusText" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                       Margin="0,8,0,0" TextWrapping="Wrap" />
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="波形缓存上限" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="WaveformLimitBox" Grid.Column="1" Width="130"
                                          SelectionChanged="OnWaveformLimitChanged">
                                    <ComboBoxItem Content="128 MB" Tag="128" />
                                    <ComboBoxItem Content="256 MB（默认）" Tag="256" />
                                    <ComboBoxItem Content="512 MB" Tag="512" />
                                    <ComboBoxItem Content="1024 MB" Tag="1024" />
                                    <ComboBoxItem Content="不限制" Tag="0" />
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="封面缓存上限" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="CoverLimitBox" Grid.Column="1" Width="160"
                                          SelectionChanged="OnCoverLimitChanged">
                                    <ComboBoxItem Content="256 MB" Tag="256" />
                                    <ComboBoxItem Content="512 MB" Tag="512" />
                                    <ComboBoxItem Content="1024 MB" Tag="1024" />
                                    <ComboBoxItem Content="2048 MB（默认）" Tag="2048" />
                                    <ComboBoxItem Content="4096 MB" Tag="4096" />
                                    <ComboBoxItem Content="不限制" Tag="0" />
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="超过上限时删除最久未使用的封面 / 波形；不限制会让缓存目录随听歌量增长。"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="打开配置目录" Style="{StaticResource FlatButton}" Click="OnOpenConfig" />
                                <Button Content="打开数据目录" Style="{StaticResource FlatButton}" Click="OnOpenData" />
                                <Button Content="打开日志目录" Style="{StaticResource FlatButton}" Click="OnOpenLogs" />
                            </StackPanel>
                            <TextBlock x:Name="DataDirText" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                       Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageFiles" Visibility="Collapsed">
                    <!-- Encoders -->
                    <TextBlock Text="编码器" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock x:Name="EncoderStatusText" Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" TextWrapping="Wrap" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Nero AAC" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Grid.Column="1" x:Name="NeroAacPathBox" Height="28" Margin="0,0,10,0"
                                         LostFocus="OnNeroAacPathLostFocus"
                                         ToolTip="neroAacEnc.exe 的完整路径" />
                                <Button Grid.Column="2" Content="浏览…" Style="{StaticResource FlatButton}"
                                        Click="OnBrowseNeroAac" />
                            </Grid>
                            <TextBlock Text="转换 AAC 需要 Nero AAC 编码器。其许可不允许随软件分发，请自行下载 neroAacEnc.exe 并在此指定路径。"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                                       Margin="90,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Loudness adjustment default target -->
                    <TextBlock Text="响度调整" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="默认目标响度" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <DockPanel Grid.Column="1">
                                    <TextBlock DockPanel.Dock="Right" Text="LUFS" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" />
                                    <TextBox x:Name="LoudnessTargetBox" Height="28" MaxWidth="140"
                                             HorizontalAlignment="Left" LostFocus="OnLoudnessTargetLostFocus"
                                             ToolTip="响度调整窗口打开时填入的目标积分响度（-60.0 … 0.0 LUFS）" />
                                </DockPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- BPM measurement (ADR-034) -->
                    <TextBlock Text="BPM 测量" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="识别模型" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox x:Name="BpmModelBox" Grid.Column="1" HorizontalAlignment="Left" MinWidth="240"
                                          SelectionChanged="OnBpmModelChanged">
                                    <ComboBoxItem Content="内置紧凑模型 (small0 · 约 10.5 MB)" Tag="Small0" />
                                    <ComboBoxItem Content="高精度主模型 (final0 · 约 80 MB，需自装)" Tag="Final0" />
                                </ComboBox>
                                <Button x:Name="BpmGuideToggleButton" Grid.Column="2" Content="安装指引 ▾"
                                        Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                                        Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center"
                                        ToolTip="展开 / 收起 final0 高精度模型的下载与安装步骤"
                                        Click="OnToggleBpmGuide" />
                            </Grid>
                            <TextBlock x:Name="BpmModelStatusText" Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" TextWrapping="Wrap" Margin="108,6,0,0" />

                            <!-- final0 下载与安装指引（默认折叠，按需展开） -->
                            <Border x:Name="BpmGuidePanel" Margin="0,8,0,0" Padding="11,9" CornerRadius="5"
                                    Background="{DynamicResource PanelAltBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="BpmFinal0GuideText" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="打开模型目录" Style="{StaticResource FlatButton}"
                                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                                Padding="9,4" Margin="0,0,6,4" Click="OnOpenBpmModelsFolder" />
                                        <Button Content="重新检测" Style="{StaticResource FlatButton}"
                                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                                Padding="9,4" Margin="0,0,6,4" Click="OnRedetectBpmModels" />
                                        <Button Content="打开下载页" Style="{StaticResource FlatButton}"
                                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                                Padding="9,4" Margin="0,0,6,4" Click="OnOpenBpmDownloadPage" />
                                        <Button Content="复制下载链接" Style="{StaticResource FlatButton}"
                                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                                Padding="9,4" Margin="0,0,0,4" Click="OnCopyBpmDownloadUrl" />
                                    </WrapPanel>
                                    <TextBlock x:Name="BpmGuideFeedbackText" FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="显示精度" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox x:Name="BpmDecimalPlacesBox" Grid.Column="1" HorizontalAlignment="Left" Width="170"
                                          SelectionChanged="OnBpmSettingsChanged">
                                    <ComboBoxItem Content="1 位小数（默认，128.0）" Tag="1" />
                                    <ComboBoxItem Content="整数（128）" Tag="0" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="显存释放" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox x:Name="BpmIdleUnloadBox" Grid.Column="1" HorizontalAlignment="Left" Width="190"
                                          SelectionChanged="OnBpmSettingsChanged">
                                    <ComboBoxItem Content="测完立即释放" Tag="0" />
                                    <ComboBoxItem Content="空闲 30 秒后释放" Tag="30" />
                                    <ComboBoxItem Content="空闲 60 秒后释放（默认）" Tag="60" />
                                    <ComboBoxItem Content="空闲 5 分钟后释放" Tag="300" />
                                </ComboBox>
                            </Grid>

                            <CheckBox x:Name="BpmUseGpuCheck" Content="优先使用 DirectML GPU 加速（不可用时自动回退 CPU）"
                                      Margin="0,12,0,0" Checked="OnBpmRuntimeChanged" Unchecked="OnBpmRuntimeChanged" />
                            <CheckBox x:Name="BpmWriteToFileDefaultCheck" Content="手动修正 BPM 时默认勾选「同时写入音频文件标签」"
                                      Margin="0,8,0,0" Checked="OnBpmSettingsChanged" Unchecked="OnBpmSettingsChanged" />
                            <CheckBox x:Name="BpmRoundId3Check" Content="写入 ID3v2 (MP3 / WAV) TBPM 时强制取整（兼容老式硬件播放器）"
                                      Margin="0,8,0,0" Checked="OnBpmSettingsChanged" Unchecked="OnBpmSettingsChanged" />
                        </StackPanel>
                    </Border>

                    <!-- Tag normalization rules (ADR-025) -->
                    <TextBlock Text="标签规范化" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock x:Name="TagNormalizationEmptyHint"
                                       Text="尚未配置规则。点击下方「恢复默认规则」可以恢复内置的两条规则。"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                            <ListBox x:Name="TagNormalizationRuleList" Margin="0,8,0,0" Background="Transparent"
                                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Content="启用" VerticalAlignment="Center"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              Click="OnTagNormalizationRuleToggled"
                                                              ToolTip="停用后该规则不会出现在右键菜单里。" />
                                                    <TextBox Grid.Column="1" Tag="name" Height="26" Margin="10,0,10,0"
                                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             TextChanged="OnTagNormalizationRuleTextChanged"
                                                             ToolTip="规则名称，显示在右键菜单「标签规范化」中。示例：清理专辑后缀" />
                                                    <ComboBox Grid.Column="2" Width="150" Height="26"
                                                              ItemsSource="{Binding TargetOptions}"
                                                              DisplayMemberPath="Label" SelectedValuePath="Key"
                                                              SelectedValue="{Binding TargetField, Mode=TwoWay}"
                                                              SelectionChanged="OnTagNormalizationTargetFieldChanged"
                                                              ToolTip="规则作用的标签字段；选择「全部可文本字段」时对常用文本字段和其他标签都生效。" />
                                                    <Button Grid.Column="3" Content="删除" Style="{StaticResource FlatButton}"
                                                            Margin="8,0,0,0" Click="OnRemoveTagNormalizationRule"
                                                            ToolTip="删除该规则（立即保存到 settings.json）。" />
                                                </Grid>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="170" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="正则" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBox Grid.Column="1" Tag="pattern" Height="26" Margin="8,0,10,0"
                                                             FontFamily="{DynamicResource MonoFont}"
                                                             Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             TextChanged="OnTagNormalizationRuleTextChanged"
                                                             ToolTip=".NET 正则表达式，可引用捕获组。示例：\s*-\s*(EP|Single)$" />
                                                    <TextBlock Grid.Column="2" Text="替换为" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBox Grid.Column="3" Tag="replacement" Height="26" Margin="8,0,0,0"
                                                             Text="{Binding Replacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             TextChanged="OnTagNormalizationRuleTextChanged"
                                                             ToolTip="替换文本，可用 $1 引用捕获组；留空表示删除匹配到的内容。" />
                                                </Grid>
                                                <TextBlock Text="{Binding ErrorText}" Visibility="{Binding ErrorVisibility}"
                                                           Foreground="{DynamicResource DangerBrush}" FontSize="11"
                                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Button x:Name="AddTagNormalizationRuleButton" Content="添加规则"
                                        Style="{StaticResource FlatButton}" Margin="0,0,8,0"
                                        Click="OnAddTagNormalizationRule" />
                                <Button Content="恢复默认规则" Style="{StaticResource FlatButton}"
                                        Click="OnResetTagNormalizationRules" />
                            </StackPanel>
                            <TextBlock x:Name="TagNormalizationRuleStatusText" Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- File operation destinations (ADR-021) -->
                    <TextBlock Text="文件操作目标文件夹" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="右键菜单「文件操作 → 复制 到 / 移动 到」会按此顺序列出这些文件夹。"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            <Border Background="{DynamicResource PanelAltBackgroundBrush}" CornerRadius="4" Margin="0,8,0,0"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4">
                                <ListBox x:Name="FileDestinationList" Height="112" Background="Transparent"
                                         BorderThickness="0" ItemContainerStyle="{StaticResource DestinationListItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="添加文件夹…" Style="{StaticResource FlatButton}" Click="OnAddFileDestination" />
                                <Button Content="移除" Style="{StaticResource FlatButton}" Click="OnRemoveFileDestination" />
                                <Button Content="上移" Style="{StaticResource FlatButton}" Click="OnMoveFileDestinationUp" />
                                <Button Content="下移" Style="{StaticResource FlatButton}" Click="OnMoveFileDestinationDown" />
                            </StackPanel>
                            <TextBlock x:Name="FileDestinationStatusText" Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="最多记住 20 个文件夹；右键菜单里的「选择文件夹…」也会自动记住新目录。" />
                        </StackPanel>
                    </Border>

                    <!-- Associations -->
                    <TextBlock Text="文件关联" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock x:Name="AssociationStatusText" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="管理文件关联…" Style="{StaticResource FlatButton}" Click="OnManageAssociations" />
                            </StackPanel>
                            <TextBlock Text="文件关联是可选手动操作，启动时不会自动注册；注册时可以选择具体格式。Windows 10/11 会保护用户已选择的默认应用，注册后需要在系统设置中确认 EchoGarage。"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageNetwork" Visibility="Collapsed">
                    <!-- Network / Web tag sources (ADR-022) -->
                    <TextBlock Text="网络与 Web 标签" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="代理模式" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="ProxyModeBox" Grid.Column="1" Width="210"
                                          SelectionChanged="OnProxyModeChanged">
                                    <ComboBoxItem Content="跟随系统" Tag="System" />
                                    <ComboBoxItem Content="不使用代理" Tag="Direct" />
                                    <ComboBoxItem Content="自定义 HTTP/HTTPS 代理" Tag="Custom" />
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="代理地址" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="ProxyUrlBox" Grid.Column="1" Width="300" Height="28"
                                         ToolTip="例如 http://127.0.0.1:7890（仅支持 http/https）"
                                         TextChanged="OnProxyUrlChanged" />
                            </Grid>
                            <TextBlock x:Name="ProxyHintText" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                <Button Content="测试连接" Style="{StaticResource FlatButton}" Click="OnTestWebConnection" />
                                <TextBlock x:Name="WebConnectionStatusText" Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12" />
                            <CheckBox x:Name="AppleMusicSourceCheck" Content="启用 Apple Music（日本）网页源"
                                      Checked="OnWebSourceChanged" Unchecked="OnWebSourceChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <!-- About -->
                    <TextBlock Text="关于" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="EchoGarage v0.1.0" FontWeight="SemiBold" />
                            <TextBlock Text="WPF / .NET 10 · NAudio WASAPI" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,4,0,0" />
                            <TextBlock x:Name="StartupText" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                       Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="DataPathText" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                       Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="关闭" Style="{StaticResource AccentButton}" Click="OnClose" IsDefault="True" />
        </StackPanel>
    </Grid>
