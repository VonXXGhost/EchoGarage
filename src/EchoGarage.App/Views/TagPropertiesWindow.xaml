<views:ThemedWindow x:Class="EchoGarage.App.Views.TagPropertiesWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EchoGarage.App.Views"
                    Title="属性"
                    Width="940" Height="640"
                    MinWidth="860" MinHeight="560"
                    WindowStartupLocation="CenterOwner"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12"
                    ShowInTaskbar="False"
                    KeyDown="OnWindowKeyDown">
    <views:ThemedWindow.Resources>
        <Style x:Key="ValuePickerButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </views:ThemedWindow.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,18,0">
            <StackPanel>
                <TextBlock x:Name="SelectionHint" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="标签信息" Style="{StaticResource SectionLabel}" Margin="0"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" x:Name="QuickNormalizeButton" Content="快捷规范化"
                            Style="{StaticResource FlatButton}" Padding="10,4" FontSize="11.5"
                            Click="OnQuickNormalizeClick"
                            ToolTip="按设置页配置的正则规则快速改写下方标签框里的文本；保存后才写入文件。" />
                </Grid>
                <TextBlock x:Name="QuickNormalizeStatusText" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,-4,0,8" Visibility="Collapsed" />
                <Grid x:Name="FieldsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                </Grid>

                <TextBlock x:Name="ExtraTagsHeader" Text="其他标签" Style="{StaticResource SectionLabel}"
                           Margin="0,18,0,8" />
                <Border x:Name="ExtraTagsPanel" Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                        Padding="12,10">
                    <ItemsControl x:Name="ExtraTagsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               ToolTip="{Binding Name}" />
                                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             Height="24" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                                    <Button Grid.Column="2" Content="×" Width="22" Height="22" FontSize="14"
                                            Style="{StaticResource ValuePickerButton}" Focusable="False"
                                            Click="OnRemoveAdditionalTag" ToolTip="删除该标签" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="0" Grid.Column="1">
            <TextBlock Text="封面" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
            <Border Width="220" Height="220" CornerRadius="6" Background="{DynamicResource CoverBoxBrush}" ClipToBounds="True"
                    HorizontalAlignment="Left">
                <Grid>
                    <Image x:Name="CoverImage" Stretch="Uniform" />
                    <TextBlock x:Name="CoverPlaceholder" Text="无封面" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <TextBlock x:Name="CoverInfoText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                       Margin="0,8,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="选择图片…" Style="{StaticResource FlatButton}" Click="OnPickCover" />
                <Button Content="快速匹配专辑封面" Style="{StaticResource FlatButton}" Click="OnQuickMatchCover"
                        ToolTip="在歌曲所在目录查找图片：只有一个图片时直接使用，多个时优先 cover / folder 命名" />
                <Button x:Name="RemoveCoverButton" Content="移除封面" Style="{StaticResource FlatButton}"
                        Click="OnRemoveCover" />
            </StackPanel>

            <TextBlock Text="封面转换" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />
            <CheckBox x:Name="ConvertCoverCheck" Content="保存时转换为 JPG" IsChecked="True"
                      Checked="OnConvertCoverChanged" Unchecked="OnConvertCoverChanged" />
            <Grid x:Name="CoverConversionOptions" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="质量 (1–100)" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,8" />
                <TextBox x:Name="CoverQualityBox" Grid.Row="0" Grid.Column="1" Height="26" Text="90"
                         Margin="0,0,0,8" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="最大边长 (px)" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" />
                <TextBox x:Name="CoverMaxEdgeBox" Grid.Row="1" Grid.Column="1" Height="26" Text="1000" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource FlatButton}" Click="OnCancel" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="保存到文件" Style="{StaticResource AccentButton}" Click="OnOk" IsDefault="True" />
        </StackPanel>
    </Grid>
</views:ThemedWindow>
