<views:ThemedWindow x:Class="EchoGarage.App.Views.TagPropertiesWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EchoGarage.App.Views"
                    Title="属性"
                    Width="760" Height="560"
                    MinWidth="680" MinHeight="500"
                    WindowStartupLocation="CenterOwner"
                    Background="{StaticResource WindowBackgroundBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12"
                    ShowInTaskbar="False"
                    KeyDown="OnWindowKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
            <StackPanel>
                <TextBlock Text="标签信息" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="标题" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                    <TextBox x:Name="TitleBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Height="28" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="艺术家" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                    <TextBox x:Name="ArtistBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Height="28" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="专辑" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                    <TextBox x:Name="AlbumBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Height="28" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="专辑艺术家" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                    <TextBox x:Name="AlbumArtistBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Height="28" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="流派" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                    <TextBox x:Name="GenreBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Height="28" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="年份 / 音轨" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                    <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="YearBox" Grid.Column="0" Height="28" ToolTip="年份" />
                        <TextBox x:Name="TrackBox" Grid.Column="2" Height="28" ToolTip="音轨号" />
                        <TextBox x:Name="DiscBox" Grid.Column="4" Height="28" ToolTip="碟号" />
                    </Grid>
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="备注" VerticalAlignment="Top" Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox x:Name="CommentBox" Grid.Row="6" Grid.Column="1" Height="70" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalContentAlignment="Top" />
                </Grid>

                <TextBlock Text="文件信息" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />
                <TextBlock x:Name="FilePathText" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                           FontSize="11" />
                <TextBlock x:Name="FileInfoText" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"
                           FontSize="11" />
                <TextBlock x:Name="ModifiedText" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"
                           FontSize="11" />
                <TextBlock Text="标签会直接写入音频文件本身（MP3/FLAC/M4A/WAV 各自的标准格式），不会存到播放器数据库。"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                           Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="0" Grid.Column="1">
            <TextBlock Text="封面" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
            <Border Width="220" Height="220" CornerRadius="6" Background="#1E242D" ClipToBounds="True"
                    HorizontalAlignment="Left">
                <Grid>
                    <Image x:Name="CoverImage" Stretch="Uniform" />
                    <TextBlock x:Name="CoverPlaceholder" Text="无封面" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="选择图片…" Style="{StaticResource FlatButton}" Click="OnPickCover" />
                <Button x:Name="RemoveCoverButton" Content="移除封面" Style="{StaticResource FlatButton}"
                        Click="OnRemoveCover" />
            </StackPanel>
            <TextBlock Text="建议使用正方形的 JPG/PNG 图片。" Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource FlatButton}" Click="OnCancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="保存到文件" Style="{StaticResource AccentButton}" Click="OnOk" IsDefault="True" />
        </StackPanel>
    </Grid>
</views:ThemedWindow>
