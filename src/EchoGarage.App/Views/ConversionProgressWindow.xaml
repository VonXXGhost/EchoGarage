<views:ThemedWindow x:Class="EchoGarage.App.Views.ConversionProgressWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EchoGarage.App.Views"
                    Title="转换"
                    Width="540"
                    Height="300"
                    MinWidth="480"
                    ResizeMode="NoResize"
                    WindowStartupLocation="CenterOwner"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12"
                    ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Style="{StaticResource SectionLabel}" />
            <TextBlock x:Name="SubtitleText"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11"
                       Margin="0,4,0,0" />
        </StackPanel>

        <TextBlock x:Name="CurrentItemText"
                   Grid.Row="1"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,18,0,0" />

        <ProgressBar x:Name="Progress"
                     Grid.Row="2"
                     Height="8"
                     Minimum="0"
                     Maximum="100"
                     Margin="0,10,0,0" />

        <Grid Grid.Row="3" Margin="0,6,0,0">
            <TextBlock x:Name="StageText"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" />
            <TextBlock x:Name="PercentText"
                       HorizontalAlignment="Right"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" />
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   VerticalAlignment="Bottom"
                   Margin="0,8,0,0" />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="CancelButton"
                    Content="取消"
                    Style="{StaticResource FlatButton}"
                    Click="OnCancelClick"
                    MinWidth="88" />
        </StackPanel>
    </Grid>
</views:ThemedWindow>
