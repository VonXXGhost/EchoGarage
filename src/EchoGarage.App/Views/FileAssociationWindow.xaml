<views:ThemedWindow x:Class="EchoGarage.App.Views.FileAssociationWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EchoGarage.App.Views"
                    Title="文件关联"
                    Width="560" Height="520"
                    MinWidth="500" MinHeight="460"
                    WindowStartupLocation="CenterOwner"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12"
                    ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="选择 EchoGarage 可以打开的音频格式" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="注册是可选手动操作，软件启动时不会自动注册。Windows 10/11 会保护用户当前的默认应用，注册后仍需在系统“默认应用”里确认。"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,6">
            <Button Content="全选" Style="{StaticResource FlatButton}" Click="OnSelectAll" />
            <Button Content="全不选" Style="{StaticResource FlatButton}" Click="OnSelectNone" />
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="ExtensionPanel" Orientation="Horizontal" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="RegistrationStatusText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="打开 Windows 默认应用" Style="{StaticResource FlatButton}" Click="OnOpenDefaultApps" />
                <Button Content="取消注册" Style="{StaticResource FlatButton}" Click="OnUnregister" Margin="8,0,0,0" />
                <Button Content="注册选中格式" Style="{StaticResource AccentButton}" Click="OnRegister" Margin="8,0,0,0" />
                <Button Content="关闭" Style="{StaticResource FlatButton}" Click="OnClose" IsCancel="True" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</views:ThemedWindow>
