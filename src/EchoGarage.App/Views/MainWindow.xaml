<Window x:Class="EchoGarage.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EchoGarage.App.ViewModels"
        xmlns:core="clr-namespace:EchoGarage.Core.Models;assembly=EchoGarage.Core"
        xmlns:svc="clr-namespace:EchoGarage.App.Services"
        xmlns:views="clr-namespace:EchoGarage.App.Views"
        xmlns:controls="clr-namespace:EchoGarage.App.Views.Controls"
        Title="EchoGarage"
        Icon="/EchoGarage;component/Resources/echogarage.ico"
        Height="880" Width="1440" MinHeight="600" MinWidth="980"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13.5"
        AllowDrop="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <svc:SecondaryTextConverter x:Key="SecondaryTextConverter" />

        <!-- 「播放列表 / 正在播放」顶部 TAB：外观对应设计稿的 view-switcher。 -->
        <Style x:Key="PageTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabRoot" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot" Property="Background"
                                        Value="{DynamicResource RowHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 「正在播放」页标签卡片：字段名 / 字段值。 -->
        <Style x:Key="TagFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style x:Key="TagFieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- 「正在播放」页右侧播放列表行：无边框卡片，播放中按主题高亮。 -->
        <Style x:Key="NowPlayingSidebarItem" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="Loaded" Handler="OnNowPlayingPageItemLoaded" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowRoot" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="8,6" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowRoot" Property="Background"
                                        Value="{DynamicResource RowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowRoot" Property="Background"
                                        Value="{DynamicResource RowSelectedBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter TargetName="RowRoot" Property="Background"
                                        Value="{DynamicResource PlayingRowBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Optional second line under a cell's primary text. The style trigger collapses the
             line when the column has no secondary format or the track value renders empty. -->
        <Style x:Key="SecondaryCellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,1,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryMonoCellText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryCellText}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        </Style>

        <!-- ================= Cell templates ================= -->
        <DataTemplate x:Key="Cell.Cover">
            <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource CoverPlaceholderBrush}"
                    BorderBrush="{DynamicResource CoverStrokeBrush}" BorderThickness="1" ClipToBounds="True"
                    Visibility="{Binding DataContext.IsGroupedViewActive, RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource InverseBoolToVisibility}}">
                <Image Source="{Binding CoverImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </DataTemplate>

        <!-- Grouped list: the album cover lives in a gutter next to the whole group, so it
             spans all songs of that album (foobar2000 style). -->
        <Style x:Key="GroupedTrackItem" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <!-- 播放中的行：左侧 3px 主题强调色竖条（owner 规范）。 -->
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource RowSeparatorBrush}" BorderThickness="0,0,0,1"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="PlayingBar" Width="3" HorizontalAlignment="Left"
                                    Background="{DynamicResource PlayingLeftBarBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter TargetName="PlayingBar" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PlayingRowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="GroupedHeaderCell">
            <Grid Width="{Binding DisplayWidth}" Background="Transparent" Cursor="Hand"
                  MouseLeftButtonUp="OnGroupedHeaderClick">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="固定在左侧" IsCheckable="True"
                                  IsChecked="{Binding IsLeftPinned, Mode=OneWay}"
                                  Click="OnGroupedHeaderPinLeftClick" />
                        <MenuItem Header="固定在右侧" IsCheckable="True"
                                  IsChecked="{Binding IsRightPinned, Mode=OneWay}"
                                  Click="OnGroupedHeaderPinRightClick" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <TextBlock Text="{Binding Header}" Margin="8,0,10,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SortGlyph}" Foreground="{DynamicResource AccentBrush}"
                           FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,9,0" />
                <!-- Boundary between the left flow and the right-pinned block: this gripper resizes
                     the last left column instead of moving the pinned block. -->
                <Border Width="1" HorizontalAlignment="Left" Margin="0,7"
                        Background="{DynamicResource BorderBrush}" IsHitTestVisible="False"
                        Visibility="{Binding ShowLeftBoundaryGripper, Converter={StaticResource BoolToVisibility}}" />
                <Thumb Width="6" HorizontalAlignment="Left" Cursor="SizeWE"
                       Visibility="{Binding ShowLeftBoundaryGripper, Converter={StaticResource BoolToVisibility}}"
                       Style="{StaticResource ColumnHeaderGripper}" ToolTip="拖动调整右侧列宽"
                       DragDelta="OnGroupedBoundaryThumbDragDelta"
                       DragCompleted="OnGroupedBoundaryThumbDragCompleted" />
                <!-- Thin vertical rule marks the exact column boundary; the gripper sits on top. -->
                <Border Width="1" HorizontalAlignment="Right" Margin="0,7"
                        Background="{DynamicResource BorderBrush}" IsHitTestVisible="False" />
                <Thumb Width="6" HorizontalAlignment="Right" Cursor="SizeWE"
                       Visibility="{Binding ShowResizeGripper, Converter={StaticResource BoolToVisibility}}"
                       Style="{StaticResource ColumnHeaderGripper}" ToolTip="拖动调整列宽"
                       DragDelta="OnGroupedColumnThumbDragDelta"
                       DragCompleted="OnGroupedColumnThumbDragCompleted" />
            </Grid>
        </DataTemplate>

        <!-- One song cell in the grouped list; used by the left flow and the right-pinned block. -->
        <DataTemplate x:Key="GroupedRowCell">
            <Border Width="{Binding HeaderSource.DisplayWidth}" Padding="8,0" Background="Transparent">
                <ContentControl Content="{Binding Row}" ContentTemplate="{Binding Template}" />
            </Border>
        </DataTemplate>

        <Style x:Key="AlbumGroupContainer" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                            <Border Height="30" Background="{DynamicResource GroupHeaderBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="8,0" Cursor="Hand"
                                    ToolTip="单击选中本组全部歌曲（按住 Ctrl 追加到当前选择）"
                                    MouseLeftButtonDown="OnGroupHeaderMouseLeftButtonDown">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Items[0].AlbumGroupTitle}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AlbumGroupForegroundBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Items[0].AlbumGroupArtist}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Height="1" Margin="12,0"
                                            Background="{DynamicResource RowSeparatorBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Items[0].AlbumGroupYear}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Auto: the gutter is exactly the cover plus its 8 DIP margins. -->
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- The cover size comes from GroupCoverMetrics.CoverSize (inherited from
                                     GroupedList). Deliberately no RelativeSource AncestorType=Window binding:
                                     virtualized group containers can be templated before they are attached
                                     to the tree, and such ancestor lookups occasionally never resolved,
                                     leaving the cover at the artwork's natural size (giant cover bug,
                                     2026-11-12). Self bindings cannot fail that way. -->
                                <Border Grid.Column="0" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Width="{Binding Path=(views:GroupCoverMetrics.CoverSize), RelativeSource={RelativeSource Self}}"
                                        Height="{Binding Path=(views:GroupCoverMetrics.CoverSize), RelativeSource={RelativeSource Self}}"
                                        CornerRadius="6" Background="{DynamicResource CoverPlaceholderBrush}"
                                        BorderBrush="{DynamicResource CoverStrokeBrush}" BorderThickness="1"
                                        ClipToBounds="True" Loaded="OnGroupCoverLoaded"
                                        IsVisibleChanged="OnGroupCoverIsVisibleChanged"
                                        DataContextChanged="OnGroupCoverDataContextChanged"
                                        Unloaded="OnGroupCoverUnloaded">
                                    <Image Source="{Binding Items[0].GroupCoverImage}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <ItemsPresenter Grid.Column="1" />
                            </Grid>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="Cell.Status">
            <TextBlock Text="{Binding StatusGlyph}" Foreground="{DynamicResource AccentBrush}" FontSize="13"
                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </DataTemplate>

        <DataTemplate x:Key="Cell.Index">
            <TextBlock Text="{Binding IndexDisplay}" Foreground="{DynamicResource TextMutedBrush}"
                       FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
        </DataTemplate>

        <DataTemplate x:Key="Cell.Title">
            <StackPanel VerticalAlignment="Center">
                <!-- 播放中的行标题使用主题的“播放行标题”色（owner 规范）。 -->
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource PlayingTitleBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Style="{StaticResource SecondaryCellText}"
                           Text="{Binding SecondaryTexts, Converter={StaticResource SecondaryTextConverter}, ConverterParameter=title}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Cell.Artist">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Artist}" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource SecondaryCellText}"
                           Text="{Binding SecondaryTexts, Converter={StaticResource SecondaryTextConverter}, ConverterParameter=artist}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Cell.Album">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Album}" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource SecondaryCellText}"
                           Text="{Binding SecondaryTexts, Converter={StaticResource SecondaryTextConverter}, ConverterParameter=album}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Cell.AlbumArtist">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding AlbumArtist}" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource SecondaryCellText}"
                           Text="{Binding SecondaryTexts, Converter={StaticResource SecondaryTextConverter}, ConverterParameter=albumArtist}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Cell.TrackNumber">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding TrackNumberText}" Foreground="{DynamicResource TextMutedBrush}"
                           FontFamily="{StaticResource MonoFont}" />
                <TextBlock Style="{StaticResource SecondaryMonoCellText}"
                           Text="{Binding SecondaryTexts, Converter={StaticResource SecondaryTextConverter}, ConverterParameter=trackNumber}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Cell.DiscNumber">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding DiscNumberText}" Foreground="{DynamicResource TextMutedBrush}"
                           FontFamily="{StaticResource MonoFont}" />
                <TextBlock Style="{StaticResource SecondaryMonoCellText}"
                           Text="{Binding SecondaryTexts, Converter={StaticResource SecondaryTextConverter}, ConverterParameter=discNumber}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Cell.Year">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Year}" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Style="{StaticResource SecondaryCellText}"
                           Text="{Binding SecondaryTexts, Converter={StaticResource SecondaryTextConverter}, ConverterParameter=year}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Cell.Genre">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Genre}" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource SecondaryCellText}"
                           Text="{Binding SecondaryTexts, Converter={StaticResource SecondaryTextConverter}, ConverterParameter=genre}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Cell.Duration">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding DurationText}" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontFamily="{StaticResource MonoFont}" />
                <TextBlock Style="{StaticResource SecondaryMonoCellText}"
                           Text="{Binding SecondaryTexts, Converter={StaticResource SecondaryTextConverter}, ConverterParameter=duration}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Cell.Bitrate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding BitrateText}" Foreground="{DynamicResource TextMutedBrush}"
                           FontFamily="{StaticResource MonoFont}" />
                <TextBlock Style="{StaticResource SecondaryMonoCellText}"
                           Text="{Binding SecondaryTexts, Converter={StaticResource SecondaryTextConverter}, ConverterParameter=bitrate}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Cell.SampleRate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding SampleRateText}" Foreground="{DynamicResource TextMutedBrush}"
                           FontFamily="{StaticResource MonoFont}" />
                <TextBlock Style="{StaticResource SecondaryMonoCellText}"
                           Text="{Binding SecondaryTexts, Converter={StaticResource SecondaryTextConverter}, ConverterParameter=sampleRate}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Cell.Codec">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Codec}" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Style="{StaticResource SecondaryCellText}"
                           Text="{Binding SecondaryTexts, Converter={StaticResource SecondaryTextConverter}, ConverterParameter=codec}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Cell.AddedAt">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding AddedText}" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Style="{StaticResource SecondaryCellText}"
                           Text="{Binding SecondaryTexts, Converter={StaticResource SecondaryTextConverter}, ConverterParameter=addedAt}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Cell.ModifiedAt">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Style="{StaticResource SecondaryCellText}"
                           Text="{Binding SecondaryTexts, Converter={StaticResource SecondaryTextConverter}, ConverterParameter=modifiedAt}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Cell.FileSize">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding FileSizeText}" Foreground="{DynamicResource TextMutedBrush}"
                           FontFamily="{StaticResource MonoFont}" />
                <TextBlock Style="{StaticResource SecondaryMonoCellText}"
                           Text="{Binding SecondaryTexts, Converter={StaticResource SecondaryTextConverter}, ConverterParameter=fileSize}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Cell.Path">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding PathText}" Foreground="{DynamicResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding PathText}" />
                <TextBlock Style="{StaticResource SecondaryCellText}"
                           Text="{Binding SecondaryTexts, Converter={StaticResource SecondaryTextConverter}, ConverterParameter=path}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Cell.Comment">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Comment}" Foreground="{DynamicResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource SecondaryCellText}"
                           Text="{Binding SecondaryTexts, Converter={StaticResource SecondaryTextConverter}, ConverterParameter=comment}" />
            </StackPanel>
        </DataTemplate>

        <!-- ================= Now-playing cover spinner ================= -->
        <!-- Rotating accent arc shown only while the large cover decodes and no previous artwork
             can stay on screen; when old art exists it is kept and crossfaded into the new one
             (CrossFadeImage), so the spinner must not cover it. The fade-in delay also hides the
             spinner for fast (cached) loads so it never flashes. -->
        <Style x:Key="NowPlayingCoverSpinner" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowCoverLoadingSpinner}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="CoverSpinnerStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                                 BeginTime="0:0:0.12" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:1.05" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="CoverSpinnerStoryboard" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ================= Sidebar item ================= -->
        <Style x:Key="SourceItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,0" Margin="6,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" Foreground="{DynamicResource NavIconBrush}"
                                           VerticalAlignment="Center" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="2,0,6,0" />
                                <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="10" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarSelectedBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SidebarSelectedForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Context menus ================= -->
        <!-- 子菜单内容在 ContextMenuOpening 里一次性构建（菜单显示之前）：
             MenuItem 没有子项时不会弹出子菜单；若等到菜单已显示后再改子项
             （Opened / SubmenuOpened），WPF 会重建已显示的菜单容器，
             鼠标移入子菜单时整条菜单链会被收起。 -->
        <ContextMenu x:Key="TrackMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="移除列表" Click="OnRemoveSelectedClick" />
            <MenuItem Header="属性（标签）…" Click="OnPropertiesClick" />
            <MenuItem Header="Web 搜索标签…" Click="OnWebTagSearchClick" />
            <MenuItem Header="标签规范化" />
            <MenuItem Header="转换" />
            <MenuItem Header="响度计算…" Click="OnLoudnessScanClick" />
            <MenuItem Header="响度调整…" Click="OnLoudnessAdjustClick" />
            <MenuItem Header="文件操作" />
            <Separator />
            <MenuItem Header="添加到播放列表…" Click="OnAddToPlaylistClick" />
            <MenuItem Header="新建播放列表…" Command="{Binding NewPlaylistCommand}" />
            <MenuItem Header="新建智能播放列表…" Command="{Binding NewSmartPlaylistCommand}" />
            <Separator />
            <MenuItem Header="在资源管理器中显示" Click="OnRevealClick" />
        </ContextMenu>

        <!-- 左侧“媒体库 / 播放列表”来源列表的右键菜单：原顶部菜单栏的“播放列表”菜单整体迁移到这里。
             命令可用状态在 ContextMenuOpening（MainWindow.Sources.cs）里按右键命中的来源节点刷新；
             DataContext 跟随 PlacementTarget（SourceList）的 DataContext，即 MainViewModel。 -->
        <ContextMenu x:Key="SourceListMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="新建播放列表…" Tag="NewPlaylist" Command="{Binding NewPlaylistCommand}" />
            <MenuItem Header="新建智能播放列表…" Tag="NewSmartPlaylist" Command="{Binding NewSmartPlaylistCommand}" />
            <Separator />
            <MenuItem Header="编辑智能条件…" Tag="EditSmartRules"
                      Click="OnSourceMenuEditSmartRulesClick" IsEnabled="False" />
            <MenuItem Header="重命名播放列表…" Tag="RenamePlaylist"
                      Click="OnSourceMenuRenamePlaylistClick" IsEnabled="False" />
            <MenuItem Header="删除播放列表…" Tag="DeletePlaylist"
                      Click="OnSourceMenuDeletePlaylistClick" IsEnabled="False" />
            <Separator />
            <MenuItem Header="从播放列表移除所选歌曲" Tag="RemoveSelected" Command="{Binding RemoveSelectedCommand}"
                      InputGestureText="Delete" IsEnabled="False" />
            <MenuItem Header="添加所选歌曲到其他播放列表…" Tag="AddSelectedToPlaylist"
                      Command="{Binding AddSelectedToPlaylistCommand}" IsEnabled="False" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Top bar ===================== -->
        <Border Grid.Row="0" Height="48" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Menu Grid.Column="1" VerticalAlignment="Center">
                    <Menu.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource TopLevelMenuItem}" />
                    </Menu.ItemContainerStyle>
                    <MenuItem Header="文件">
                        <MenuItem Header="添加文件到当前播放列表…" Command="{Binding AddFilesCommand}" InputGestureText="Ctrl+O" />
                        <MenuItem Header="添加媒体库文件夹…" Command="{Binding AddLibraryFolderCommand}" />
                        <MenuItem Header="重新扫描媒体库" Command="{Binding RescanCommand}" InputGestureText="F5" />
                        <MenuItem Header="导出配置…" Command="{Binding ExportConfigurationCommand}" />
                        <MenuItem Header="导入配置…" Command="{Binding ImportConfigurationCommand}" />
                        <Separator />
                        <MenuItem Header="注册为默认播放器…" Command="{Binding RegisterDefaultPlayerCommand}" />
                        <MenuItem Header="设置…" Command="{Binding OpenSettingsCommand}" />
                        <MenuItem Header="转换器设置…" Click="OnConversionSettingsClick" />
                        <MenuItem Header="打开日志目录" Command="{Binding OpenLogsCommand}" />
                        <Separator />
                        <MenuItem Header="退出" Click="OnExitMenuClick" />
                    </MenuItem>
                    <MenuItem Header="视图">
                        <MenuItem Header="显示专辑信息面板" Command="{Binding ToggleAlbumPanelCommand}" />
                        <MenuItem Header="按专辑分组" IsCheckable="True" IsChecked="{Binding GroupByAlbum, Mode=TwoWay}"
                                  ToolTip="分组列表只在按“专辑”或“专辑艺术家”排序时显示；开启分组会自动切换为按专辑排序，这两列可以隐藏。" />
                        <!-- 主题统一收进二级菜单：一级项只保留一个「主题」，点击后选择具体主题。 -->
                        <MenuItem x:Name="ThemeMenu" Header="主题">
                            <MenuItem Header="纯净极简白" Tag="0" IsCheckable="True"
                                      Command="{Binding SetThemeCommand}" CommandParameter="0"
                                      ToolTip="通透克制的默认浅色主题" />
                            <MenuItem Header="温润纸感白" Tag="1" IsCheckable="True"
                                      Command="{Binding SetThemeCommand}" CommandParameter="1"
                                      ToolTip="暖白纸张质感，长时间阅读更柔和" />
                            <MenuItem Header="极简冰青白" Tag="2" IsCheckable="True"
                                      Command="{Binding SetThemeCommand}" CommandParameter="2"
                                      ToolTip="冷调冰蓝，清爽利落" />
                            <MenuItem Header="午夜黑胶" Tag="3" IsCheckable="True"
                                      Command="{Binding SetThemeCommand}" CommandParameter="3"
                                      ToolTip="暖色深色主题，黑胶夜色氛围" />
                            <MenuItem Header="深海蓝灰" Tag="4" IsCheckable="True"
                                      Command="{Binding SetThemeCommand}" CommandParameter="4"
                                      ToolTip="冷灰深色主题，沉稳专业" />
                        </MenuItem>
                        <MenuItem Header="列与布局…" Command="{Binding EditColumnsCommand}" />
                        <MenuItem Header="显示字段说明…" Click="OnFieldGuideMenuClick" />
                        <Separator />
                        <MenuItem Header="打开配置目录" Command="{Binding OpenConfigFolderCommand}" />
                    </MenuItem>
                </Menu>

                <!-- 页面切换（设计稿顶部 TAB）：播放列表 / 正在播放。 -->
                <Border Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                        Background="{DynamicResource PanelAltBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="☰ 播放列表" Command="{Binding ShowPlaylistPageCommand}"
                                AutomationProperties.AutomationId="PlaylistPageTab">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PageTabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNowPlayingPageActive}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="♪ 正在播放" Command="{Binding ShowNowPlayingPageCommand}"
                                AutomationProperties.AutomationId="NowPlayingPageTab">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PageTabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNowPlayingPageActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="输出" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                               Margin="0,0,6,0" FontSize="12" />
                    <ComboBox Width="250" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="FriendlyName" ToolTip="{Binding OutputDescription}" />
                    <ComboBox Width="92" Margin="6,0,0,0" ItemsSource="{Binding OutputModeOptions}"
                              SelectedIndex="{Binding OutputModeIndex}" />
                    <Button Content="⚙" FontSize="14" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0"
                            ToolTip="设置" Command="{Binding OpenSettingsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Content ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="236" MinWidth="170" MaxWidth="420" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="AlbumPanelColumn" Width="320" MinWidth="240" MaxWidth="520" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsNowPlayingPageActive, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid x:Name="SidebarRoot">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox x:Name="SourceList" Grid.Row="0" Background="Transparent" BorderThickness="0"
                             AutomationProperties.AutomationId="SourceList"
                             AllowDrop="True"
                             ItemsSource="{Binding SourcesView}"
                             ContextMenu="{StaticResource SourceListMenu}"
                             ContextMenuOpening="OnSourceListContextMenuOpening"
                             SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource SourceItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="OnSourceSelectionChanged"
                             PreviewMouseLeftButtonDown="OnSourceListPreviewMouseLeftButtonDown"
                             PreviewMouseRightButtonDown="OnSourceListPreviewMouseRightButtonDown"
                             PreviewMouseMove="OnSourceListPreviewMouseMove"
                             DragOver="OnSourceListDragOver"
                             Drop="OnSourceListDrop"
                             DragLeave="OnSourceListDragLeave">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabel}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <!-- 播放列表拖拽排序时的插入位置指示线：由 MainWindow.Playlists.cs 定位并显示。 -->
                    <Border x:Name="SourceDropIndicator" Grid.RowSpan="2" Height="2" Margin="8,0,8,0"
                            VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            Background="{DynamicResource AccentBrush}"
                            IsHitTestVisible="False" Visibility="Collapsed" Panel.ZIndex="100" />

                    <StackPanel Grid.Row="1" Margin="8,6,8,10">
                        <Button Content="＋ 新建播放列表" Style="{StaticResource FlatButton}" HorizontalAlignment="Stretch"
                                Foreground="{DynamicResource TextSecondaryBrush}" Command="{Binding NewPlaylistCommand}" />
                        <Button Content="＋ 添加媒体库文件夹" Style="{StaticResource FlatButton}" HorizontalAlignment="Stretch"
                                Foreground="{DynamicResource TextSecondaryBrush}" Command="{Binding AddLibraryFolderCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Track list page（原来的播放列表页；「正在播放」页激活时整页隐藏） -->
            <Grid x:Name="PlaylistPageRoot" Grid.Column="1" Background="{DynamicResource MainBackgroundBrush}"
                  Visibility="{Binding IsNowPlayingPageActive, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,12,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlaylistTitle}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PlaylistSubtitle}" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="240" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBox x:Name="SearchBox" Height="28" Padding="3,0,24,0" FontSize="12"
                                     Background="{DynamicResource SearchBackgroundBrush}"
                                     AutomationProperties.AutomationId="SearchBox"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnSearchBoxKeyDown"
                                     ToolTip="搜索当前播放列表的标题、艺术家、专辑、专辑艺术家；空格分隔多个关键词。Ctrl+F 打开高级搜索，可按字段搜索。" />
                            <TextBlock Text="搜索标题 / 艺术家 / 专辑…" Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilterText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Content="✕" Width="22" Height="22" Padding="0" FontSize="11"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                                    Style="{StaticResource FlatButton}" ToolTip="清空搜索 (Esc)"
                                    Command="{Binding ClearFilterCommand}"
                                    Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <Button Content="添加文件" Style="{StaticResource ToolbarButton}" Command="{Binding AddFilesCommand}" />
                        <Button Content="预设" Style="{StaticResource ToolbarButton}" Click="OnPresetButtonClick"
                                ToolTip="快速切换播放列表的列显示预设" />
                        <Button Content="列与布局" Style="{StaticResource ToolbarButton}" Command="{Binding EditColumnsCommand}" />
                        <Button Content="扫描媒体库" Style="{StaticResource ToolbarButton}" Command="{Binding RescanCommand}" />
                        <Button Content="智能条件" Command="{Binding EditSmartRulesCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSource.IsSmart}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="TrackGrid" Grid.Row="1"
                          AutomationProperties.AutomationId="TrackGrid"
                          Visibility="{Binding IsGroupedViewActive, Converter={StaticResource InverseBoolToVisibility}}"
                          ItemsSource="{Binding TracksView}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          SelectionChanged="OnTrackSelectionChanged"
                          MouseDoubleClick="OnTrackGridDoubleClick"
                          LoadingRow="OnTrackGridLoadingRow"
                          UnloadingRow="OnTrackGridUnloadingRow"
                          Sorting="OnTrackGridSorting"
                          ContextMenu="{StaticResource TrackMenu}"
                          PreviewMouseRightButtonDown="OnTrackGridPreviewMouseRightButtonDown"
                          PreviewMouseLeftButtonDown="OnTrackGridMarqueeStart"
                          PreviewMouseMove="OnTrackGridMarqueeMove"
                          PreviewMouseLeftButtonUp="OnTrackGridMarqueeEnd"
                          LostMouseCapture="OnMarqueeLostCapture"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          ScrollViewer.CanContentScroll="True"
                          Margin="0,0,0,0" />

                <!-- Grouped view: foobar2000-style album gutter; the cover spans the whole
                     group and songs are listed to its right. -->
                <Grid Grid.Row="1" Visibility="{Binding IsGroupedViewActive, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                            ClipToBounds="True">
                        <Grid x:Name="GroupedHeaderGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding GroupCoverColumnWidth}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Background="Transparent">
                                <TextBlock Text="封面" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                           Margin="8,0,10,0" VerticalAlignment="Center" />
                                <!-- Same boundary rule as the song columns; the cover gripper sits on top. -->
                                <Border Width="1" HorizontalAlignment="Right" Margin="0,7"
                                        Background="{DynamicResource BorderBrush}" IsHitTestVisible="False" />
                                <Thumb x:Name="GroupCoverThumb" Width="6" HorizontalAlignment="Right"
                                       Cursor="SizeWE" Style="{StaticResource ColumnHeaderGripper}"
                                       DragDelta="OnGroupCoverThumbDragDelta"
                                       DragCompleted="OnGroupCoverThumbDragCompleted" />
                            </Grid>
                            <ItemsControl x:Name="GroupedLeftHeaderItems" Grid.Column="1"
                                          ItemsSource="{Binding GroupedLeftColumns}"
                                          ItemTemplate="{StaticResource GroupedHeaderCell}"
                                          ClipToBounds="True" HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl x:Name="GroupedRightHeaderItems" Grid.Column="2"
                                          ItemsSource="{Binding GroupedRightColumns}"
                                          ItemTemplate="{StaticResource GroupedHeaderCell}"
                                          ClipToBounds="True" HorizontalAlignment="Right">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <ListView x:Name="GroupedList" Grid.Row="1"
                              AutomationProperties.AutomationId="GroupedList"
                              ItemsSource="{Binding GroupedTracksView}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              SelectionChanged="OnGroupedSelectionChanged"
                              MouseDoubleClick="OnGroupedDoubleClick"
                              ContextMenu="{StaticResource TrackMenu}"
                              PreviewMouseRightButtonDown="OnGroupedListPreviewMouseRightButtonDown"
                              PreviewMouseLeftButtonDown="OnGroupedListMarqueeStart"
                              PreviewMouseMove="OnGroupedListMarqueeMove"
                              PreviewMouseLeftButtonUp="OnGroupedListMarqueeEnd"
                              LostMouseCapture="OnMarqueeLostCapture"
                              Background="Transparent" BorderThickness="0" Padding="0"
                              SelectionMode="Extended"
                              ItemContainerStyle="{StaticResource GroupedTrackItem}"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.CacheLength="2"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              UseLayoutRounding="True">
                        <ListView.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource AlbumGroupContainer}" />
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ItemsControl Grid.Column="0" ItemsSource="{Binding Cells}"
                                                  HorizontalAlignment="Left"
                                                  ItemTemplate="{StaticResource GroupedRowCell}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding RightCells}"
                                                  HorizontalAlignment="Right"
                                                  ItemTemplate="{StaticResource GroupedRowCell}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasTracks, Converter={StaticResource InverseBoolToVisibility}}"
                            IsHitTestVisible="False">
                    <TextBlock Text="♪" FontSize="46" Foreground="{DynamicResource EmptyGlyphBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyListTitle}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding EmptyListHint}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Rubber-band selection overlay; drawn while dragging on empty list space. -->
                <Canvas x:Name="MarqueeLayer" Grid.Row="1" IsHitTestVisible="False"
                        ClipToBounds="True" Visibility="Collapsed">
                    <Border x:Name="MarqueeBorder" Visibility="Collapsed"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1" Opacity="0.7" />
                </Canvas>

                <!-- Playlist switch overlay: painted as soon as a switch starts so a slow switch
                     never looks frozen. A short 60 ms fade delay keeps switches that finish almost
                     immediately from flashing the overlay. Spinner only, no text (owner feedback). -->
                <Grid Grid.Row="1" Panel.ZIndex="50" Opacity="0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="IsHitTestVisible" Value="True" />
                                    <DataTrigger.EnterActions>
                                        <!-- Restart from the hidden state: stop the previous fade-out and
                                             the still-held fade-in before beginning a new one. -->
                                        <StopStoryboard BeginStoryboardName="ListLoadingFadeOut" />
                                        <StopStoryboard BeginStoryboardName="ListLoadingFadeIn" />
                                        <BeginStoryboard x:Name="ListLoadingFadeIn">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                                                 BeginTime="0:0:0.06" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <!-- The fade-in is deliberately not stopped here: WPF composes a
                                             newly started animation on top of the active ones, so this
                                             fade-out starts from whatever opacity the fade-in currently
                                             shows and early-finished switches still fade out smoothly. -->
                                        <BeginStoryboard x:Name="ListLoadingFadeOut">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                                                                 Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border Background="{DynamicResource MainBackgroundBrush}" Opacity="0.82" />
                    <Grid Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform />
                        </Grid.RenderTransform>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="ListLoadingSpinnerSpin">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        From="0" To="360" Duration="0:0:0.9" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="ListLoadingSpinnerSpin" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <!-- Faint full ring plus a 90° accent arc that spins. -->
                        <Ellipse Width="40" Height="40" Stroke="{DynamicResource CoverNoteBrush}"
                                 StrokeThickness="2.5" Opacity="0.3" />
                        <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 20,5 A 15,15 0 0 1 35,20" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- ===================== 正在播放页 ===================== -->
            <!-- 与播放列表页平行的一页（顶部 TAB 切换）：左侧封面 + 元数据 + 可视化，右侧为
                 与播放列表页顺序一致的当前播放列表（不分组、不支持拖拽排序）。左侧资料库
                 面板与右侧专辑面板在本页激活时收起。背景柔光由当前封面实时取色。 -->
            <Grid x:Name="NowPlayingPageRoot" Grid.Column="1"
                  SizeChanged="OnNowPlayingPageSizeChanged"
                  Visibility="{Binding IsNowPlayingPageActive, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="344" />
                </Grid.ColumnDefinitions>

                <!-- 左：封面 + 元数据 + 频谱 -->
                <Grid Grid.Column="0" Background="{DynamicResource WindowBackgroundBrush}">
                    <controls:CoverGlow PrimaryColor="{Binding NowPlayingGlowPrimary}"
                                         SecondaryColor="{Binding NowPlayingGlowSecondary}"
                                         PrimaryOpacity="{DynamicResource NowPlayingGlowPrimaryAlpha}"
                                         SecondaryOpacity="{DynamicResource NowPlayingGlowSecondaryAlpha}" />
                    <Grid Margin="28,24,28,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 封面：双击打开大图浏览（与专辑面板的交互一致）。 -->
                            <Border x:Name="NowPlayingCoverFrame" Grid.Column="0" Width="300" Height="300" CornerRadius="8"
                                    Background="{DynamicResource CoverBoxBrush}"
                                    BorderBrush="{DynamicResource CoverStrokeBrush}" BorderThickness="1"
                                    ClipToBounds="True" VerticalAlignment="Top" Cursor="Hand"
                                    ToolTip="双击放大浏览封面"
                                    AutomationProperties.AutomationId="NowPlayingPageCover"
                                    MouseLeftButtonDown="OnNowPlayingCoverMouseLeftButtonDown"
                                    Visibility="{Binding HasCurrentTrack, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <TextBlock Text="♪" FontSize="54" Foreground="{DynamicResource CoverNoteBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding ShowCoverPlaceholder, Converter={StaticResource BoolToVisibility}}" />
                                    <controls:CrossFadeImage Source="{Binding CurrentCover}" />
                                    <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Style="{StaticResource NowPlayingCoverSpinner}">
                                        <Ellipse Width="52" Height="52" Stroke="{DynamicResource CoverNoteBrush}"
                                                 StrokeThickness="3" Opacity="0.35" />
                                        <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 26,4 A 22,22 0 1 1 4,26" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 未播放时保持同样尺寸的占位，避免页面布局跳动。 -->
                            <Border x:Name="NowPlayingCoverFramePlaceholder" Grid.Column="0" Width="300" Height="300" CornerRadius="8"
                                    Background="{DynamicResource CoverPlaceholderBrush}"
                                    BorderBrush="{DynamicResource CoverStrokeBrush}" BorderThickness="1"
                                    Visibility="{Binding HasCurrentTrack, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="♪" FontSize="54" Foreground="{DynamicResource EmptyGlyphBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <Grid Grid.Column="1" Margin="32,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="NowPlayingPageTitle" Text="{Binding CurrentTitle}"
                                                   FontSize="30" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxHeight="78" />
                                        <TextBlock FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding CurrentSubtitle, Mode=OneWay}" />
                                            <Run Text="  ·  " Foreground="{DynamicResource TextMutedBrush}" />
                                            <Run Text="{Binding CurrentInfo, Mode=OneWay}" />
                                        </TextBlock>
                                        <WrapPanel Margin="0,12,0,0">
                                            <Border Background="{DynamicResource AccentSoftBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                                    CornerRadius="6" Padding="8,2" Margin="0,0,7,6">
                                                <TextBlock Text="{Binding NowPlayingGenre}" FontSize="11.5"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="6" Padding="8,2" Margin="0,0,7,6">
                                                <TextBlock Text="{Binding NowPlayingYear}" FontSize="11.5"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                            <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="6" Padding="8,2" Margin="0,0,7,6">
                                                <TextBlock Text="{Binding NowPlayingFormatText}" FontSize="11.5"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="✎ 标签属性" VerticalAlignment="Top"
                                            Style="{StaticResource FlatButton}" Margin="12,0,0,0"
                                            IsEnabled="{Binding HasCurrentTrack}"
                                            Click="OnNowPlayingEditTagsClick" />
                                </Grid>

                                <!-- 标签卡片：字段名 / 值三列排布，最后一行是文件路径。
                                     窗口高度不足时由代码隐藏整张卡片，优先保证封面与频谱的高度。 -->
                                <Grid x:Name="NowPlayingTagCardHost" Grid.Row="1">
                                <Border Margin="0,16,0,0" CornerRadius="10"
                                        Background="{DynamicResource PanelBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Padding="16,13,16,13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,18,11">
                                            <TextBlock Text="专辑艺术家" Style="{StaticResource TagFieldLabel}" />
                                            <TextBlock Text="{Binding NowPlayingAlbumArtist}" Style="{StaticResource TagFieldValue}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,18,11">
                                            <TextBlock Text="作曲家" Style="{StaticResource TagFieldLabel}" />
                                            <TextBlock Text="{Binding NowPlayingComposer}" Style="{StaticResource TagFieldValue}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,11">
                                            <TextBlock Text="流派" Style="{StaticResource TagFieldLabel}" />
                                            <TextBlock Text="{Binding NowPlayingGenre}" Style="{StaticResource TagFieldValue}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,18,11">
                                            <TextBlock Text="年份" Style="{StaticResource TagFieldLabel}" />
                                            <TextBlock Text="{Binding NowPlayingYear}" Style="{StaticResource TagFieldValue}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,18,11">
                                            <TextBlock Text="音轨号" Style="{StaticResource TagFieldLabel}" />
                                            <TextBlock Text="{Binding NowPlayingTrackNumber}" Style="{StaticResource TagFieldValue}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,11">
                                            <TextBlock Text="碟片号" Style="{StaticResource TagFieldLabel}" />
                                            <TextBlock Text="{Binding NowPlayingDiscNumber}" Style="{StaticResource TagFieldValue}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,18,0">
                                            <TextBlock Text="编码器" Style="{StaticResource TagFieldLabel}" />
                                            <TextBlock Text="{Binding NowPlayingCodec}" Style="{StaticResource TagFieldValue}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="备注" Style="{StaticResource TagFieldLabel}" />
                                            <TextBlock Text="{Binding NowPlayingComment}" Style="{StaticResource TagFieldValue}" />
                                        </StackPanel>

                                        <Border Grid.Row="3" Grid.ColumnSpan="3" Margin="0,11,0,0" Padding="0,8,0,0"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                            <TextBlock Text="{Binding NowPlayingPath}" FontSize="11.5"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding NowPlayingPath}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- 频谱可视化：复用现有 SpectrumView（与专辑面板共用同一个数据源；隐藏时不渲染）。 -->
                        <Border x:Name="NowPlayingVizCard" Grid.Row="1" Margin="0,18,0,0" CornerRadius="12" MinHeight="120"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Padding="12,10,12,8"
                                Visibility="{Binding ShowVisualizer, Converter={StaticResource BoolToVisibility}}">
                            <controls:SpectrumView x:Name="NowPlayingPageSpectrum"
                                                   Source="{Binding Spectrum}"
                                                   Options="{Binding SpectrumOptions}"
                                                   FrameRateLimit="{Binding VisualizerFrameRateLimit}"
                                                   AutomationProperties.AutomationId="NowPlayingPageSpectrum" />
                        </Border>
                    </Grid>
                </Grid>

                <!-- 右：当前播放列表（顺序与播放列表页一致，不分组，不可拖拽排序） -->
                <Border Grid.Column="1" Background="{DynamicResource SidebarBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                    <Grid Margin="12,12,12,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="2,0,2,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlaylistTitle}" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="正在播放的列表" FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Center" Margin="8,0,6,0"
                                    Background="{DynamicResource PanelAltBackgroundBrush}" CornerRadius="99" Padding="7,2">
                                <TextBlock Text="{Binding NowPlayingPlaylistCountText}" FontSize="11"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <Button Grid.Column="2" Content="◎" Style="{StaticResource ToolbarButton}"
                                    Width="26" Padding="0" ToolTip="定位到正在播放的歌曲"
                                    Click="OnNowPlayingLocateClick"
                                    AutomationProperties.AutomationId="NowPlayingLocateButton" />
                        </Grid>

                        <ListView x:Name="NowPlayingPageList" Grid.Row="1"
                                  AutomationProperties.AutomationId="NowPlayingPageList"
                                  ItemsSource="{Binding NowPlayingPlaylistRows}"
                                  ItemContainerStyle="{StaticResource NowPlayingSidebarItem}"
                                  Background="Transparent" BorderThickness="0" Padding="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.CacheLength="2"
                                  MouseDoubleClick="OnNowPlayingPageListDoubleClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 序号；播放中的行改为 ♪ 强调色。 -->
                                        <TextBlock Grid.Column="0" Text="{Binding IndexDisplay}" FontSize="9.5"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="0" Text="♪" FontSize="11"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="5"
                                                Margin="0,0,10,0"
                                                Background="{DynamicResource CoverPlaceholderBrush}"
                                                BorderBrush="{DynamicResource CoverStrokeBrush}" BorderThickness="1"
                                                ClipToBounds="True">
                                            <Image Source="{Binding CoverImage}" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource PlayingTitleBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="0,1,0,0" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Artist, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Album, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="11"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="8,0,0,0"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Album panel -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowPlaylistAlbumPanel, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer x:Name="NowPlayingScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="18,16,18,18">
                    <!-- MinHeight 绑视口高度：内容不足一屏时 Grid 撑满面板，星号行才能拿到“剩余空间”；
                         内容超过一屏时照常滚动（小窗口 / 高 DPI 下仍然可用）。 -->
                    <Grid MinHeight="{Binding ViewportHeight, ElementName=NowPlayingScroll}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 只留封面与基础歌曲信息：格式 / 采样率 / 路径等细节在列表与标签面板里已有，
                             面板标题与文件信息行按 owner 要求移除（ADR-023）。 -->
                        <StackPanel Grid.Row="0" Visibility="{Binding HasCurrentTrack, Converter={StaticResource BoolToVisibility}}">
                            <!-- 双击封面打开大图浏览窗口（CoverViewerWindow）；无封面时由 handler 忽略。 -->
                            <Border x:Name="NowPlayingCoverBorder" CornerRadius="6"
                                    Background="{DynamicResource CoverBoxBrush}"
                                    BorderBrush="{DynamicResource CoverStrokeBrush}" BorderThickness="1"
                                    ClipToBounds="True" Height="300"
                                    Cursor="Hand" ToolTip="双击放大浏览封面"
                                    AutomationProperties.AutomationId="NowPlayingCover"
                                    MouseLeftButtonDown="OnNowPlayingCoverMouseLeftButtonDown">
                                <Grid>
                                    <!-- 占位符放在封面下层：新封面淡入时把它逐渐盖住，旧封面淡出时再逐渐露出。
                                         切歌过渡由 CrossFadeImage 完成（保留旧图 + 新图交叉淡入），不再先清空旧图；
                                         转圈只在没有旧封面可显示时出现（ShowCoverLoadingSpinner）。 -->
                                    <TextBlock Text="♪" FontSize="54" Foreground="{DynamicResource CoverNoteBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding ShowCoverPlaceholder, Converter={StaticResource BoolToVisibility}}" />
                                    <controls:CrossFadeImage Source="{Binding CurrentCover}" />
                                    <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Style="{StaticResource NowPlayingCoverSpinner}">
                                        <Ellipse Width="52" Height="52" Stroke="{DynamicResource CoverNoteBrush}"
                                                 StrokeThickness="3" Opacity="0.35" />
                                        <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 26,4 A 22,22 0 1 1 4,26" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding CurrentTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52" />
                            <TextBlock Text="{Binding CurrentSubtitle}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentInfo}" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Visibility="{Binding HasCurrentTrack, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="未在播放" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                            <TextBlock Text="在列表中双击歌曲，或按空格开始播放。" Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>

                        <!-- 播放可视化（ADR-023）：第一阶段内置分段频谱图，填满面板剩余高度。 -->
                        <controls:SpectrumView x:Name="NowPlayingSpectrum" Grid.Row="2" Margin="0,14,0,0"
                                               MinHeight="96"
                                               Source="{Binding Spectrum}"
                                               Options="{Binding SpectrumOptions}"
                                               FrameRateLimit="{Binding VisualizerFrameRateLimit}"
                                               AutomationProperties.AutomationId="NowPlayingSpectrum"
                                               Visibility="{Binding ShowVisualizer, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </ScrollViewer>
            </Border>
            <!-- Draggable column boundaries. The splitter hit area overlays the existing
                 border line so the layout does not gain a gap; the safe ranges come from the
                 column MinWidth / MaxWidth values.
                 ResizeBehavior must be PreviousAndCurrent: each splitter is aligned Left inside
                 the content column, so it resizes the column before it and the column it sits in.
                 (PreviousAndNext needs a column on both sides; on the last column it silently
                 does nothing, which is why the right panel could not be dragged.) -->
            <GridSplitter x:Name="SidebarSplitterCtl" Grid.Column="1" Width="6" HorizontalAlignment="Left"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent" Cursor="SizeWE"
                          Background="Transparent" AutomationProperties.AutomationId="SidebarSplitter"
                          Visibility="{Binding IsNowPlayingPageActive, Converter={StaticResource InverseBoolToVisibility}}"
                          ToolTip="拖拽调整左侧面板宽度" />
            <GridSplitter x:Name="AlbumPanelSplitterCtl" Grid.Column="2" Width="6" HorizontalAlignment="Left"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent" Cursor="SizeWE"
                          Background="Transparent" AutomationProperties.AutomationId="AlbumPanelSplitter"
                          Visibility="{Binding ShowPlaylistAlbumPanel, Converter={StaticResource BoolToVisibility}}"
                          ToolTip="拖拽调整右侧面板宽度" />
        </Grid>

        <!-- ===================== Status bar ===================== -->
        <!-- Left: current track (♪ title — artist — album, missing tags skipped) or "就绪".
             Right: transient status hint (scan / import / errors) plus the scan progress bar. -->
        <Border Grid.Row="2" Height="30" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Double-click: jump to and center the playing row when it is part of the
                     list that is currently browsed (see MainWindow.NowPlaying.cs). -->
                <TextBlock Grid.Column="0" Text="{Binding NowPlayingStatusText}"
                           AutomationProperties.AutomationId="NowPlayingStatus"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" FontSize="12"
                           TextTrimming="CharacterEllipsis" Cursor="Hand"
                           Background="Transparent"
                           MouseLeftButtonDown="OnNowPlayingStatusMouseLeftButtonDown">
                    <TextBlock.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock Text="{Binding NowPlayingStatusText}" />
                                <TextBlock Text="双击跳转到正在播放的歌曲"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"
                                           Visibility="{Binding HasCurrentTrack, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" MaxWidth="620"
                           AutomationProperties.AutomationId="StatusHint"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" FontSize="12"
                           TextTrimming="CharacterEllipsis" Margin="16,0,0,0"
                           ToolTip="{Binding StatusMessage}"
                           Visibility="{Binding HasStatusHint, Converter={StaticResource BoolToVisibility}}" />
                <ProgressBar Grid.Column="2" Width="120" Height="3" Margin="12,0,0,0" VerticalAlignment="Center"
                             Value="{Binding ScanProgress}" Maximum="100"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- ===================== Transport ===================== -->
        <Border Grid.Row="3" Height="72" Background="{DynamicResource TransportBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⏮" Style="{StaticResource TransportButton}" Command="{Binding PlayPreviousCommand}"
                            ToolTip="上一首" />
                    <Button Content="{Binding PlayGlyph}" Style="{StaticResource PlayButton}" Margin="6,0"
                            Command="{Binding PlayPauseCommand}" ToolTip="播放 / 暂停 (空格)" />
                    <Button Content="⏹" Style="{StaticResource TransportButton}" Command="{Binding StopCommand}"
                            ToolTip="停止" />
                    <Button Content="⏭" Style="{StaticResource TransportButton}" Command="{Binding PlayNextCommand}"
                            ToolTip="下一首" />
                </StackPanel>

                <Grid Grid.Column="1" Margin="20,0" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0" Style="{StaticResource WaveformModeToggle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsWaveformMode, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="WaveformModeToggle"
                                  AutomationProperties.Name="进度条形态">
                        <Grid Width="16" Height="16">
                            <!-- 滑杆形态：水平轨道 + 圆形滑块 -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Path Width="16" Height="16"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M2.5,8 H13.5" />
                                <Ellipse Width="5" Height="5"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <!-- 波形形态：高低不一的竖条 -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Path Width="16" Height="16"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M3.5,6 V10 M8,2.5 V13.5 M12.5,5 V11" />
                            </Grid>
                        </Grid>
                    </ToggleButton>
                    <TextBlock Grid.Column="1" Text="{Binding PositionText}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" />
                    <Grid Grid.Column="2">
                        <Slider x:Name="SeekSlider" Minimum="0" Maximum="{Binding SeekMaximum}"
                                AutomationProperties.AutomationId="SeekSlider"
                                Value="{Binding PositionSeconds, Mode=OneWay}"
                                IsEnabled="{Binding HasCurrentTrack}"
                                IsMoveToPointEnabled="False"
                                Visibility="{Binding IsWaveformMode, Converter={StaticResource InverseBoolToVisibility}}" />
                        <controls:WaveformSeekBar x:Name="WaveformView"
                                  Margin="0,4"
                                  AutomationProperties.AutomationId="WaveformSeekBar"
                                  AutomationProperties.Name="播放进度"
                                  AutomationProperties.HelpText="左右方向键跳转 5 秒，Shift 加方向键跳转 1 秒"
                                  Peaks="{Binding CurrentWaveform}"
                                  Position="{Binding PositionSeconds}"
                                  Duration="{Binding DurationSeconds}"
                                  IsEnabled="{Binding HasCurrentTrack}"
                                  Visibility="{Binding IsWaveformMode, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="{DynamicResource TextMutedBrush}"
                               FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Background="Transparent"
                                PreviewMouseWheel="OnVolumeAreaMouseWheel">
                        <Button Command="{Binding ToggleMuteCommand}" ToolTip="{Binding MuteToolTip}"
                                AutomationProperties.AutomationId="VolumePercentButton"
                                AutomationProperties.Name="{Binding MuteToolTip}"
                                Cursor="Hand" Padding="0,4" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding VolumeText}" Width="38" TextAlignment="Right"
                                       FontFamily="{StaticResource MonoFont}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Slider Width="120" Margin="8,0,0,0" Minimum="0" Maximum="100"
                                AutomationProperties.AutomationId="VolumeSlider"
                                ToolTip="{Binding VolumeToolTip}"
                                Value="{Binding Volume, Mode=TwoWay}" />
                    </StackPanel>

                    <Button x:Name="PlayModeButton" Margin="10,0,0,0" Click="OnPlayModeButtonClick"
                            Style="{StaticResource TransportButton}"
                            ToolTip="{Binding PlayModeToolTip}"
                            AutomationProperties.AutomationId="PlayModeButton"
                            AutomationProperties.Name="{Binding PlayModeLabel}">
                        <Grid Width="16" Height="16">
                            <!-- 顺序播放：向右箭头 -->
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Data="M2.5,8 H13 M9.5,4.5 L13,8 L9.5,11.5">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShuffleEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRepeatOneEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <!-- 随机播放：交叉箭头 -->
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M2.5,4.5 H5.2 C7.6,4.5 8.4,11.5 10.8,11.5 H13 M10.5,9 L13,11.5 L10.5,14 M2.5,11.5 H5.2 C7.6,11.5 8.4,4.5 10.8,4.5 H13 M10.5,2 L13,4.5 L10.5,7">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShuffleEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <!-- 单曲循环：循环箭头 + 1 -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRepeatOneEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M13.2,8 A5.2,5.2 0 1 1 7.9,2.8" />
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Data="M9.9,1.5 L7.9,2.8 L9.9,4.1" />
                                <TextBlock Text="1" FontSize="6.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,0,1,1"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Grid>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

