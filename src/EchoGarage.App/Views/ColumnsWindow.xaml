<views:ThemedWindow x:Class="EchoGarage.App.Views.ColumnsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EchoGarage.App.Views"
                    Title="列与布局"
                    Width="780" Height="600"
                    MinWidth="700" MinHeight="480"
                    WindowStartupLocation="CenterOwner"
                    Background="{StaticResource WindowBackgroundBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12"
                    ShowInTaskbar="False"
                    KeyDown="OnWindowKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
            <TextBlock Text="每一列都可以显示/隐藏、调整宽度和顺序；这些设置按播放列表分别保存。" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="显示 / 列名" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="宽度" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                    <TextBlock Grid.Column="2" Text="顺序" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                </Grid>
                <ListBox x:Name="ColumnList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="10,3">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding Header}" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="24" Margin="0,2,10,2" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="↑" Style="{StaticResource FlatButton}" Padding="6,2" FontSize="11"
                                            Click="OnMoveUp" />
                                    <Button Content="↓" Style="{StaticResource FlatButton}" Padding="6,2" FontSize="11"
                                            Click="OnMoveDown" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBlock Text="快速选择显示预设" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
            <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Height="170">
                <ListBox x:Name="PresetList" Background="Transparent" BorderThickness="0" DisplayMemberPath="Name"
                         Padding="4">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="应用" Style="{StaticResource FlatButton}" Click="OnApplyPreset" />
                <Button Content="保存为预设" Style="{StaticResource FlatButton}" Click="OnSavePreset" />
                <Button Content="删除" Style="{StaticResource FlatButton}" Click="OnDeletePreset" />
            </StackPanel>

            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14" />

            <TextBlock Text="排序" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
            <ComboBox x:Name="SortColumnBox" />
            <CheckBox x:Name="DescendingBox" Content="降序" Margin="0,10,0,0" />
            <TextBlock Text="排序也可以在表头上点击列名切换。" Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource FlatButton}" Click="OnCancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="确定" Style="{StaticResource AccentButton}" Click="OnOk" IsDefault="True" />
        </StackPanel>
    </Grid>
</views:ThemedWindow>
