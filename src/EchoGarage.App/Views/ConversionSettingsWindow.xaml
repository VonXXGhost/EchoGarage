<views:ThemedWindow x:Class="EchoGarage.App.Views.ConversionSettingsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EchoGarage.App.Views"
                    xmlns:hotkeys="clr-namespace:EchoGarage.App.Controls"
                    Title="转换器设置"
                    Width="940"
                    Height="740"
                    MinWidth="860"
                    MinHeight="620"
                    WindowStartupLocation="CenterOwner"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12"
                    ShowInTaskbar="False"
                    KeyDown="OnWindowKeyDown"
                    Closing="OnWindowClosing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="预设" Style="{StaticResource SectionLabel}" Margin="4,4,4,6" />
                    <ListBox Grid.Row="1"
                             x:Name="PresetList"
                             DisplayMemberPath="Name"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="OnPresetSelectionChanged" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="新建" Style="{StaticResource FlatButton}" Click="OnNewPresetClick" Margin="0,0,6,0" />
                        <Button Content="复制" Style="{StaticResource FlatButton}" Click="OnDuplicatePresetClick" Margin="0,0,6,0" />
                        <Button Content="删除" Style="{StaticResource FlatButton}" Click="OnDeletePresetClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="预设设置" Style="{StaticResource SectionLabel}" />

                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" VerticalAlignment="Center" Margin="0,6" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Height="26" Margin="0,4" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="格式" VerticalAlignment="Center" Margin="0,6" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FormatBox" Height="26" Margin="0,4" SelectionChanged="OnFormatSelectionChanged" />

                            <TextBlock Grid.Row="2" Grid.Column="0" x:Name="RateModeLabel" Text="码率模式" VerticalAlignment="Center" Margin="0,6" />
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="RateModeBox" Height="26" Margin="0,4" SelectionChanged="OnFormatSelectionChanged" />

                            <TextBlock Grid.Row="3" Grid.Column="0" x:Name="QualityLabel" Text="质量" VerticalAlignment="Center" Margin="0,6" />
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="QualityBox" Height="26" Margin="0,4" />

                            <TextBlock Grid.Row="4" Grid.Column="0" x:Name="BitrateLabel" Text="比特率 (kbps)" VerticalAlignment="Center" Margin="0,6" />
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="BitrateBox" Height="26" Margin="0,4" />

                            <TextBlock Grid.Row="5" Grid.Column="0" x:Name="BitDepthLabel" Text="位深" VerticalAlignment="Center" Margin="0,6" />
                            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="BitDepthBox" Height="26" Margin="0,4" />
                        </Grid>
                    </Border>

                    <TextBlock Text="输出目标" Style="{StaticResource SectionLabel}" Margin="0,14,0,0" />
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="输出位置" VerticalAlignment="Center" Margin="0,6" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="OutputModeBox" Height="26" Margin="0,4" SelectionChanged="OnOutputModeChanged" />

                            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="OutputFolderLabel" Text="自定义文件夹" VerticalAlignment="Center" Margin="0,6" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="OutputFolderBox" Height="26" Margin="0,4" />
                            <Button Grid.Row="1" Grid.Column="2" x:Name="BrowseOutputFolderButton" Content="浏览…" Style="{StaticResource FlatButton}" Click="OnBrowseOutputFolderClick" Margin="8,4,0,4" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="文件名模板" VerticalAlignment="Center" Margin="0,6" />
                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TemplateBox" Height="26" Margin="0,4" ToolTip="可用：%title% %artist% %album% %albumartist% %composer% %genre% %year% %track% %disc% %filename% %codec%；文件名中的 * 会写作 x" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="冲突处理" VerticalAlignment="Center" Margin="0,6" />
                            <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ConflictBox" Height="26" Margin="0,4" />
                        </Grid>
                    </Border>

                    <TextBlock Text="处理与标签" Style="{StaticResource SectionLabel}" Margin="0,14,0,0" />
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="重采样" VerticalAlignment="Center" Margin="0,6" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6">
                                <CheckBox x:Name="ResampleCheck" Content="启用重采样" VerticalAlignment="Center" Margin="0,0,16,0"
                                          Checked="OnResampleChanged" Unchecked="OnResampleChanged" />
                                <TextBlock x:Name="SampleRateLabel" Text="目标采样率" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="SampleRateBox" Width="120" Height="26" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="ProfileLabel" Text="重采样质量" VerticalAlignment="Center" Margin="0,6" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ProfileBox" Height="26" Margin="0,4" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="标签" VerticalAlignment="Center" Margin="0,6" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6">
                                <CheckBox x:Name="CopyTagsCheck" Content="复制标签" Margin="0,0,16,0" />
                                <CheckBox x:Name="CopyCoverCheck" Content="复制内嵌封面" />
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="快捷键" VerticalAlignment="Center" Margin="0,6" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6">
                                <hotkeys:HotkeyCaptureButton x:Name="HotkeyBox" Width="220" Height="26"
                                                             Style="{StaticResource HotkeyCaptureButton}"
                                                             GestureCommitted="OnHotkeyGestureCommitted" />
                                <CheckBox x:Name="HotkeyGlobalCheck" Content="全局（软件在后台也生效）" VerticalAlignment="Center"
                                          Margin="12,0,0,0" Click="OnHotkeyGlobalChanged" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="StatusText"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="关闭" Style="{StaticResource FlatButton}" Click="OnCloseClick" Margin="0,0,8,0" MinWidth="88" />
            <Button Content="保存" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnSaveClick" MinWidth="88" />
        </StackPanel>
    </Grid>
</views:ThemedWindow>
