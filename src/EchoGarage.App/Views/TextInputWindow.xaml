<views:ThemedWindow x:Class="EchoGarage.App.Views.TextInputWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EchoGarage.App.Views"
                    Title="输入"
                    Width="420" SizeToContent="Height"
                    WindowStartupLocation="CenterOwner"
                    Background="{StaticResource WindowBackgroundBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12"
                    ResizeMode="NoResize"
                    ShowInTaskbar="False"
                    KeyDown="OnWindowKeyDown">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" Text="名称" Foreground="{StaticResource TextSecondaryBrush}" />
        <TextBox x:Name="ValueBox" Margin="0,8,0,0" Height="30" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource FlatButton}" Click="OnCancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="确定" Style="{StaticResource AccentButton}" Click="OnOk" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</views:ThemedWindow>
