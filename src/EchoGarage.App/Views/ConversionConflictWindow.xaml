<views:ThemedWindow x:Class="EchoGarage.App.Views.ConversionConflictWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EchoGarage.App.Views"
                    Title="转换器"
                    Width="460"
                    SizeToContent="Height"
                    ResizeMode="NoResize"
                    WindowStartupLocation="CenterOwner"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontFamily="{StaticResource UiFont}"
                    FontSize="12"
                    ShowInTaskbar="False"
                    KeyDown="OnWindowKeyDown">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <TextBlock Text="选择后将对本批次中所有冲突文件应用同一处理方式。"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="取消"
                    Style="{StaticResource FlatButton}"
                    IsCancel="True"
                    Click="OnCancelClick"
                    Margin="0,0,8,0" />
            <Button Content="跳过冲突"
                    Style="{StaticResource FlatButton}"
                    Click="OnSkipClick"
                    Margin="0,0,8,0" />
            <Button Content="重命名"
                    Style="{StaticResource FlatButton}"
                    Click="OnRenameClick"
                    Margin="0,0,8,0" />
            <Button Content="覆盖全部"
                    Style="{StaticResource AccentButton}"
                    IsDefault="True"
                    Click="OnOverwriteClick" />
        </StackPanel>
    </StackPanel>
</views:ThemedWindow>
