<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowBackgroundColor">#0E1014</Color>
    <Color x:Key="PanelBackgroundColor">#151920</Color>
    <Color x:Key="PanelAltBackgroundColor">#1A1F27</Color>
    <Color x:Key="HeaderBackgroundColor">#101318</Color>
    <Color x:Key="BorderColor">#242A34</Color>
    <Color x:Key="BorderStrongColor">#313947</Color>
    <Color x:Key="TextPrimaryColor">#E7EAEF</Color>
    <Color x:Key="TextSecondaryColor">#9BA3AF</Color>
    <Color x:Key="TextMutedColor">#6C7480</Color>
    <Color x:Key="AccentColor">#5B8DEF</Color>
    <Color x:Key="AccentSoftColor">#24324F</Color>
    <Color x:Key="RowHoverColor">#1B212A</Color>
    <Color x:Key="RowSelectedColor">#253450</Color>
    <Color x:Key="PlayingRowColor">#1B2739</Color>
    <Color x:Key="DangerColor">#E05C5C</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="PanelAltBackgroundBrush" Color="{StaticResource PanelAltBackgroundColor}" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource HeaderBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHoverColor}" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="{StaticResource RowSelectedColor}" />
    <SolidColorBrush x:Key="PlayingRowBrush" Color="{StaticResource PlayingRowColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, Microsoft YaHei UI</FontFamily>

    <DropShadowEffect x:Key="PopupShadow" BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="#000000" />

</ResourceDictionary>
