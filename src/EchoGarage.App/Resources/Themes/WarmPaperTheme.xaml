<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- 主题：Warm Paper（温润纸感白）（由 UI 主题规范定义；所有界面颜色必须引用这里的令牌） -->

    <!-- 背景 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FCFBF9" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#F5F2EC" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F5F2EC" />
    <SolidColorBrush x:Key="MainBackgroundBrush" Color="#FCFBF9" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FCFBF9" />
    <SolidColorBrush x:Key="TransportBackgroundBrush" Color="#FCFBF9" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#F8F6F1" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelAltBackgroundBrush" Color="#F5F1EA" />
    <SolidColorBrush x:Key="SearchBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GroupHeaderBackgroundBrush" Color="#F3EFE6" />

    <!-- 分隔线与描边 -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E6E1D8" />
    <SolidColorBrush x:Key="RowSeparatorBrush" Color="#EFECE5" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#DCD6CC" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#C4BBAD" />
    <SolidColorBrush x:Key="CoverStrokeBrush" Color="#E6E1D8" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C1917" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#78716C" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A8A29E" />
    <SolidColorBrush x:Key="NavIconBrush" Color="#44403C" />
    <SolidColorBrush x:Key="AlbumGroupForegroundBrush" Color="#B45309" />

    <!-- 强调与交互 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#D97706" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#B45309" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#92400E" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FDF3E7" />
    <SolidColorBrush x:Key="AccentContrastBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CheckGlyphBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F6F3EC" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#FBEEDC" />
    <SolidColorBrush x:Key="PlayingRowBrush" Color="#FEF6EE" />
    <SolidColorBrush x:Key="PlayingLeftBarBrush" Color="#D97706" />
    <SolidColorBrush x:Key="PlayingTitleBrush" Color="#92400E" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#ECE7DE" />
    <SolidColorBrush x:Key="SidebarSelectedBackgroundBrush" Color="#FDF3E7" />
    <SolidColorBrush x:Key="SidebarSelectedForegroundBrush" Color="#B45309" />

    <!-- 控件 -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#E7E5E4" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#D6CFC3" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#C0B7A8" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E7E2D8" />
    <SolidColorBrush x:Key="CoverPlaceholderBrush" Color="#F0EBE2" />
    <SolidColorBrush x:Key="CoverBoxBrush" Color="#EFE9DF" />
    <SolidColorBrush x:Key="EmptyGlyphBrush" Color="#D6CFC3" />
    <SolidColorBrush x:Key="CoverNoteBrush" Color="#C9C0B2" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />

    <!-- 波形 -->
    <SolidColorBrush x:Key="WaveformLowBrush" Color="#C45C4B" />
    <SolidColorBrush x:Key="WaveformMidBrush" Color="#DFA648" />
    <SolidColorBrush x:Key="WaveformHighBrush" Color="#2B8A9C" />
    <SolidColorBrush x:Key="WaveformTrackBackgroundBrush" Color="#F2EDE5" />
    <SolidColorBrush x:Key="WaveformPlayheadBrush" Color="#1C1917" />

    <!-- 频谱 -->
    <SolidColorBrush x:Key="SpectrumBarBottomBrush" Color="#FDE68A" />
    <SolidColorBrush x:Key="SpectrumBarTopBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="SpectrumPeakBrush" Color="#B45309" />
    <SolidColorBrush x:Key="SpectrumGridBrush" Color="#EFECE6" />
    <SolidColorBrush x:Key="SpectrumLabelBrush" Color="#A8A29E" />

    <!-- 字体与阴影 -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, Microsoft YaHei UI</FontFamily>
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="18" ShadowDepth="4" Opacity="0.16" Color="#000000" />

    <!-- 正在播放页封面柔光：两束径向渐变的峰值不透明度。深色主题需要更高的峰值才看得见。 -->
    <sys:Double x:Key="NowPlayingGlowPrimaryAlpha">0.22</sys:Double>
    <sys:Double x:Key="NowPlayingGlowSecondaryAlpha">0.11</sys:Double>
</ResourceDictionary>
