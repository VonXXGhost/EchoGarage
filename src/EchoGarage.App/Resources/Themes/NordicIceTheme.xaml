<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 主题：Nordic Ice（极简冰青白）（由 UI 主题规范定义；所有界面颜色必须引用这里的令牌） -->

    <!-- 背景 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#F3F6F7" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F3F6F7" />
    <SolidColorBrush x:Key="MainBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TransportBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#F8FAFB" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelAltBackgroundBrush" Color="#F1F5F6" />
    <SolidColorBrush x:Key="SearchBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GroupHeaderBackgroundBrush" Color="#F0F5F6" />

    <!-- 分隔线与描边 -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8EA" />
    <SolidColorBrush x:Key="RowSeparatorBrush" Color="#EDF2F4" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#D3DCE0" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#B4C4C9" />
    <SolidColorBrush x:Key="CoverStrokeBrush" Color="#E2E8EA" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="NavIconBrush" Color="#374151" />
    <SolidColorBrush x:Key="AlbumGroupForegroundBrush" Color="#0F766E" />

    <!-- 强调与交互 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0D9488" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0F766E" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#115E59" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E6F6F4" />
    <SolidColorBrush x:Key="AccentContrastBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CheckGlyphBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F4F8F8" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#E2F3F0" />
    <SolidColorBrush x:Key="PlayingRowBrush" Color="#ECFDF5" />
    <SolidColorBrush x:Key="PlayingLeftBarBrush" Color="#0D9488" />
    <SolidColorBrush x:Key="PlayingTitleBrush" Color="#115E59" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#E7EEF0" />
    <SolidColorBrush x:Key="SidebarSelectedBackgroundBrush" Color="#E6F6F4" />
    <SolidColorBrush x:Key="SidebarSelectedForegroundBrush" Color="#0F766E" />

    <!-- 控件 -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#C9D6DA" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#AEBFC4" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E4ECEE" />
    <SolidColorBrush x:Key="CoverPlaceholderBrush" Color="#EAF1F3" />
    <SolidColorBrush x:Key="CoverBoxBrush" Color="#E7EFF1" />
    <SolidColorBrush x:Key="EmptyGlyphBrush" Color="#CBD8DC" />
    <SolidColorBrush x:Key="CoverNoteBrush" Color="#B8C8CD" />
    <SolidColorBrush x:Key="DangerBrush" Color="#BE123C" />

    <!-- 波形 -->
    <SolidColorBrush x:Key="WaveformLowBrush" Color="#CF636C" />
    <SolidColorBrush x:Key="WaveformMidBrush" Color="#47A388" />
    <SolidColorBrush x:Key="WaveformHighBrush" Color="#2E74C7" />
    <SolidColorBrush x:Key="WaveformTrackBackgroundBrush" Color="#F0F5F6" />
    <SolidColorBrush x:Key="WaveformPlayheadBrush" Color="#0F172A" />

    <!-- 频谱 -->
    <SolidColorBrush x:Key="SpectrumBarBottomBrush" Color="#99F6E4" />
    <SolidColorBrush x:Key="SpectrumBarTopBrush" Color="#14B8A6" />
    <SolidColorBrush x:Key="SpectrumPeakBrush" Color="#0F766E" />
    <SolidColorBrush x:Key="SpectrumGridBrush" Color="#EDF2F4" />
    <SolidColorBrush x:Key="SpectrumLabelBrush" Color="#9CA3AF" />

    <!-- 字体与阴影 -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, Microsoft YaHei UI</FontFamily>
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="18" ShadowDepth="4" Opacity="0.16" Color="#000000" />
</ResourceDictionary>
