<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- 主题：Midnight Vinyl（午夜黑胶）（由 UI 主题规范定义；所有界面颜色必须引用这里的令牌） -->

    <!-- 背景 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#121316" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#121316" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#121316" />
    <SolidColorBrush x:Key="MainBackgroundBrush" Color="#181A1F" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#181A1F" />
    <SolidColorBrush x:Key="TransportBackgroundBrush" Color="#121316" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#14161A" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#1E2128" />
    <SolidColorBrush x:Key="PanelAltBackgroundBrush" Color="#1E2128" />
    <SolidColorBrush x:Key="SearchBackgroundBrush" Color="#1E2128" />
    <SolidColorBrush x:Key="GroupHeaderBackgroundBrush" Color="#14161A" />

    <!-- 分隔线与描边 -->
    <SolidColorBrush x:Key="BorderBrush" Color="#24272E" />
    <SolidColorBrush x:Key="RowSeparatorBrush" Color="#20232A" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#2E323C" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#3E434E" />
    <SolidColorBrush x:Key="CoverStrokeBrush" Color="#2E323C" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="NavIconBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AlbumGroupForegroundBrush" Color="#F59E0B" />

    <!-- 强调与交互 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D97706" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#B45309" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A2418" />
    <SolidColorBrush x:Key="AccentContrastBrush" Color="#121316" />
    <SolidColorBrush x:Key="CheckGlyphBrush" Color="#121316" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#20232A" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#2B2A20" />
    <SolidColorBrush x:Key="PlayingRowBrush" Color="#25221B" />
    <SolidColorBrush x:Key="PlayingLeftBarBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="PlayingTitleBrush" Color="#FDE68A" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1E2128" />
    <SolidColorBrush x:Key="SidebarSelectedBackgroundBrush" Color="#2A2418" />
    <SolidColorBrush x:Key="SidebarSelectedForegroundBrush" Color="#FBBF24" />

    <!-- 控件 -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#2E323C" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#3A3E47" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#4E535E" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#262A31" />
    <SolidColorBrush x:Key="CoverPlaceholderBrush" Color="#22252C" />
    <SolidColorBrush x:Key="CoverBoxBrush" Color="#1E2128" />
    <SolidColorBrush x:Key="EmptyGlyphBrush" Color="#2E323C" />
    <SolidColorBrush x:Key="CoverNoteBrush" Color="#3A3F49" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />

    <!-- 波形 -->
    <SolidColorBrush x:Key="WaveformLowBrush" Color="#DC5A5A" />
    <SolidColorBrush x:Key="WaveformMidBrush" Color="#DDA03B" />
    <SolidColorBrush x:Key="WaveformHighBrush" Color="#56B4E9" />
    <SolidColorBrush x:Key="WaveformTrackBackgroundBrush" Color="#1A1D23" />
    <SolidColorBrush x:Key="WaveformPlayheadBrush" Color="#FFFFFF" />

    <!-- 频谱 -->
    <SolidColorBrush x:Key="SpectrumBarBottomBrush" Color="#B45309" />
    <SolidColorBrush x:Key="SpectrumBarTopBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="SpectrumPeakBrush" Color="#FEF08A" />
    <SolidColorBrush x:Key="SpectrumGridBrush" Color="#262932" />
    <SolidColorBrush x:Key="SpectrumLabelBrush" Color="#64748B" />

    <!-- 字体与阴影 -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, Microsoft YaHei UI</FontFamily>
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="#000000" />

    <!-- 正在播放页封面柔光：两束径向渐变的峰值不透明度。深色主题需要更高的峰值才看得见。 -->
    <sys:Double x:Key="NowPlayingGlowPrimaryAlpha">0.30</sys:Double>
    <sys:Double x:Key="NowPlayingGlowSecondaryAlpha">0.17</sys:Double>
</ResourceDictionary>
