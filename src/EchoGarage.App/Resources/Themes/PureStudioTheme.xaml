<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 主题：Pure Studio（纯净极简白）（由 UI 主题规范定义；所有界面颜色必须引用这里的令牌） -->

    <!-- 背景 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#F6F8FA" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F6F8FA" />
    <SolidColorBrush x:Key="MainBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TransportBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FAFBFD" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelAltBackgroundBrush" Color="#F4F7FA" />
    <SolidColorBrush x:Key="SearchBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GroupHeaderBackgroundBrush" Color="#F2F5F9" />

    <!-- 分隔线与描边 -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E9F0" />
    <SolidColorBrush x:Key="RowSeparatorBrush" Color="#EDF0F5" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#DCE1E8" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#B9C4D4" />
    <SolidColorBrush x:Key="CoverStrokeBrush" Color="#E2E8F0" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="NavIconBrush" Color="#334155" />
    <SolidColorBrush x:Key="AlbumGroupForegroundBrush" Color="#1D4ED8" />

    <!-- 强调与交互 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EBF3FF" />
    <SolidColorBrush x:Key="AccentContrastBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CheckGlyphBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#E8F1FE" />
    <SolidColorBrush x:Key="PlayingRowBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="PlayingLeftBarBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="PlayingTitleBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#EDF2F7" />
    <SolidColorBrush x:Key="SidebarSelectedBackgroundBrush" Color="#EBF3FF" />
    <SolidColorBrush x:Key="SidebarSelectedForegroundBrush" Color="#1D4ED8" />

    <!-- 控件 -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#A9B6C8" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="CoverPlaceholderBrush" Color="#E9EEF5" />
    <SolidColorBrush x:Key="CoverBoxBrush" Color="#E7ECF3" />
    <SolidColorBrush x:Key="EmptyGlyphBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="CoverNoteBrush" Color="#B9C6D6" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />

    <!-- 波形 -->
    <SolidColorBrush x:Key="WaveformLowBrush" Color="#C45C4B" />
    <SolidColorBrush x:Key="WaveformMidBrush" Color="#E3AE52" />
    <SolidColorBrush x:Key="WaveformHighBrush" Color="#3572DC" />
    <SolidColorBrush x:Key="WaveformTrackBackgroundBrush" Color="#F1F4F8" />
    <SolidColorBrush x:Key="WaveformPlayheadBrush" Color="#0F172A" />

    <!-- 频谱 -->
    <SolidColorBrush x:Key="SpectrumBarBottomBrush" Color="#93C5FD" />
    <SolidColorBrush x:Key="SpectrumBarTopBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="SpectrumPeakBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="SpectrumGridBrush" Color="#EEF2F6" />
    <SolidColorBrush x:Key="SpectrumLabelBrush" Color="#94A3B8" />

    <!-- 字体与阴影 -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, Microsoft YaHei UI</FontFamily>
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#000000" />
</ResourceDictionary>
