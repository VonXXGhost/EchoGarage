<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- EchoGarage light theme ("daylight"): white panels on a soft grey canvas. -->
    <Color x:Key="WindowBackgroundColor">#F4F6F9</Color>
    <Color x:Key="PanelBackgroundColor">#FFFFFF</Color>
    <Color x:Key="PanelAltBackgroundColor">#F0F2F6</Color>
    <Color x:Key="HeaderBackgroundColor">#E9ECF1</Color>
    <Color x:Key="BorderColor">#DCE0E7</Color>
    <Color x:Key="BorderStrongColor">#C3CAD5</Color>
    <Color x:Key="TextPrimaryColor">#1B1F27</Color>
    <Color x:Key="TextSecondaryColor">#4C5462</Color>
    <Color x:Key="TextMutedColor">#7C8492</Color>
    <Color x:Key="AccentColor">#2F6BDE</Color>
    <Color x:Key="AccentSoftColor">#DCE7FB</Color>
    <Color x:Key="RowHoverColor">#EDF1F7</Color>
    <Color x:Key="RowSelectedColor">#D6E3FA</Color>
    <Color x:Key="PlayingRowColor">#E4EEFC</Color>
    <Color x:Key="DangerColor">#C63D3D</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="PanelAltBackgroundBrush" Color="{StaticResource PanelAltBackgroundColor}" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource HeaderBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="RowSeparatorBrush" Color="#EDF0F4" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHoverColor}" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="{StaticResource RowSelectedColor}" />
    <SolidColorBrush x:Key="PlayingRowBrush" Color="{StaticResource PlayingRowColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <!-- Control-level tokens -->
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3F7CEC" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2559C0" />
    <SolidColorBrush x:Key="AccentContrastBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CheckGlyphBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#AEB7C4" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#D6DBE3" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#BFC6D1" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#A6AFBD" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#D9DEE6" />
    <SolidColorBrush x:Key="GroupHeaderBackgroundBrush" Color="#F1F3F7" />
    <SolidColorBrush x:Key="CoverPlaceholderBrush" Color="#E7EBF1" />
    <SolidColorBrush x:Key="CoverBoxBrush" Color="#E6EAF0" />
    <SolidColorBrush x:Key="EmptyGlyphBrush" Color="#D3D9E2" />
    <SolidColorBrush x:Key="CoverNoteBrush" Color="#C3CAD6" />

    <!-- ADR-015 波形进度条：浅色面板下奶油色几乎不可见，整体压深一档并给一条浅灰轨道底。 -->
    <SolidColorBrush x:Key="WaveformLowBrush" Color="#C9A36B" />
    <SolidColorBrush x:Key="WaveformMidBrush" Color="#B2691F" />
    <SolidColorBrush x:Key="WaveformHighBrush" Color="#2F55C8" />
    <SolidColorBrush x:Key="WaveformTrackBackgroundBrush" Color="#F0F2F6" />
    <SolidColorBrush x:Key="WaveformPlayedOverlayBrush" Color="#73FFFFFF" />
    <SolidColorBrush x:Key="WaveformPlayheadBrush" Color="#1B1F27" />

    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, Microsoft YaHei UI</FontFamily>

    <DropShadowEffect x:Key="PopupShadow" BlurRadius="18" ShadowDepth="4" Opacity="0.22" Color="#000000" />

</ResourceDictionary>
