<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 主题：Slate Studio（深海蓝灰）（由 UI 主题规范定义；所有界面颜色必须引用这里的令牌） -->

    <!-- 背景 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="MainBackgroundBrush" Color="#162032" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#162032" />
    <SolidColorBrush x:Key="TransportBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#111927" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="PanelAltBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="SearchBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="GroupHeaderBackgroundBrush" Color="#111927" />

    <!-- 分隔线与描边 -->
    <SolidColorBrush x:Key="BorderBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="RowSeparatorBrush" Color="#233044" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#334155" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#46566B" />
    <SolidColorBrush x:Key="CoverStrokeBrush" Color="#334155" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="NavIconBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AlbumGroupForegroundBrush" Color="#38BDF8" />

    <!-- 强调与交互 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0EA5E9" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0369A1" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#172554" />
    <SolidColorBrush x:Key="AccentContrastBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CheckGlyphBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#1B2B47" />
    <SolidColorBrush x:Key="PlayingRowBrush" Color="#172554" />
    <SolidColorBrush x:Key="PlayingLeftBarBrush" Color="#0EA5E9" />
    <SolidColorBrush x:Key="PlayingTitleBrush" Color="#BAE6FD" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="SidebarSelectedBackgroundBrush" Color="#172554" />
    <SolidColorBrush x:Key="SidebarSelectedForegroundBrush" Color="#38BDF8" />

    <!-- 控件 -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#334155" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#3B4A5F" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#4E6076" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#243044" />
    <SolidColorBrush x:Key="CoverPlaceholderBrush" Color="#1E2A3D" />
    <SolidColorBrush x:Key="CoverBoxBrush" Color="#1B2436" />
    <SolidColorBrush x:Key="EmptyGlyphBrush" Color="#334155" />
    <SolidColorBrush x:Key="CoverNoteBrush" Color="#3E4C60" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />

    <!-- 波形 -->
    <SolidColorBrush x:Key="WaveformLowBrush" Color="#E07A48" />
    <SolidColorBrush x:Key="WaveformMidBrush" Color="#4EB888" />
    <SolidColorBrush x:Key="WaveformHighBrush" Color="#4FA8E8" />
    <SolidColorBrush x:Key="WaveformTrackBackgroundBrush" Color="#1A2434" />
    <SolidColorBrush x:Key="WaveformPlayheadBrush" Color="#F8FAFC" />

    <!-- 频谱 -->
    <SolidColorBrush x:Key="SpectrumBarBottomBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="SpectrumBarTopBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="SpectrumPeakBrush" Color="#E0F2FE" />
    <SolidColorBrush x:Key="SpectrumGridBrush" Color="#233044" />
    <SolidColorBrush x:Key="SpectrumLabelBrush" Color="#64748B" />

    <!-- 字体与阴影 -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, Microsoft YaHei UI</FontFamily>
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="#000000" />
</ResourceDictionary>
