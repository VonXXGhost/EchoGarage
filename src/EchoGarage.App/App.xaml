<Application x:Class="EchoGarage.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:EchoGarage.App.Services"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/PureStudioTheme.xaml" />
                <ResourceDictionary Source="Resources/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <services:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <services:NullToVisibilityConverter x:Key="NullToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
