<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>EchoGarage.App</RootNamespace>
    <AssemblyName>EchoGarage</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationTitle>EchoGarage</ApplicationTitle>
    <AssemblyTitle>EchoGarage</AssemblyTitle>
    <Description>EchoGarage — a fast, personal local music player for Windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EchoGarage.Core\EchoGarage.Core.csproj" />
    <ProjectReference Include="..\EchoGarage.Infrastructure\EchoGarage.Infrastructure.csproj" />
  </ItemGroup>

</Project>
